<!DOCTYPE html>
<html>
<head>
  <title>Portal ETE — Painel Diário</title>
  <%- include('../System/headIncludes.ejs') %>
  <style>
    .painel-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
    }
    .painel-card {
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 3px 12px rgba(0,0,0,.08);
      overflow: hidden;
    }
    .painel-head {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 16px;
      color: #fff;
    }
    .painel-head-icon {
      width: 38px; height: 38px; border-radius: 10px;
      background: rgba(255,255,255,.18);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; flex-shrink: 0;
    }
    .painel-head-title { font-weight: 700; font-size: .95rem; }
    .painel-head-sub { font-size: .7rem; opacity: .85; }
    .painel-body { padding: 14px 16px 16px; }

    .painel-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 14px;
    }
    .painel-stat {
      background: #f8f9fa;
      border-radius: 10px;
      padding: 10px 12px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .painel-stat-icon {
      width: 32px; height: 32px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: .95rem; flex-shrink: 0;
    }
    .painel-stat-val { font-size: 1.25rem; font-weight: 700; line-height: 1; color: #2c3e50; }
    .painel-stat-lbl { font-size: .68rem; color: #6b7280; margin-top: 2px; }

    .painel-pct-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
    }
    .painel-pct-lbl { font-size: .74rem; color: #6b7280; font-weight: 600; }
    .painel-pct-badge {
      font-size: .74rem; font-weight: 700; padding: 3px 10px; border-radius: 20px;
    }
    .painel-pct-badge.pct-ok   { background: rgba(22,163,74,.12); color: #16a34a; }
    .painel-pct-badge.pct-warn { background: rgba(217,119,6,.12); color: #d97706; }
    .painel-pct-badge.pct-bad  { background: rgba(185,28,28,.12); color: #b91c1c; }
    .painel-pct-badge.pct-none { background: #f1f3f5; color: #9ca3af; }
    .painel-progress { height: 8px; border-radius: 6px; background: #eef0f3; margin-bottom: 16px; }
    .painel-progress-bar { height: 100%; border-radius: 6px; transition: width .3s; }

    .painel-mes {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px;
      border-radius: 10px;
      background: #f8f9fa;
      margin-bottom: 14px;
    }
    .painel-mes-pct { font-size: 1.7rem; font-weight: 700; color: #2B286F; line-height: 1; }
    .painel-mes-lbl { font-size: .68rem; color: #6b7280; text-transform: uppercase; letter-spacing: .3px; font-weight: 600; }
    .painel-mes-nums { font-size: .74rem; color: #6b7280; margin-top: 3px; }

    .painel-rank-title {
      font-size: .68rem; color: #9ca3af; text-transform: uppercase;
      letter-spacing: .4px; font-weight: 700; margin-bottom: 6px;
    }
    .painel-rank-row {
      display: flex; justify-content: space-between; align-items: center;
      font-size: .82rem; padding: 6px 0; border-bottom: 1px solid #f1f3f5;
    }
    .painel-rank-row:last-child { border-bottom: none; }
    .painel-rank-label { color: #1f2430; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 8px; }
    .painel-rank-val { font-weight: 700; color: #2B286F; flex-shrink: 0; }
    .painel-rank-total { font-weight: 700; border-top: 1.5px solid #e9edf2; margin-top: 4px; padding-top: 8px; }
    .painel-empty { text-align: center; color: #9ca3af; font-size: .8rem; padding: 12px 0; }
  </style>
</head>
<body>
  <div class="layout-container">
    <%- include('../partials/sidebar') %>
    <div class="main-content">
      <%- include('../partials/topbar', { pageTitle: 'Painel Diário', pageIcon: 'speedometer', username: username }) %>
      <%- include('../partials/bottomnav') %>

      <div class="content">
        <%
          function fmtInt(v) {
            if (v == null) return '—';
            return Number(v).toLocaleString('pt-BR');
          }
          function pctClass(p) {
            if (p == null) return 'pct-none';
            if (p >= 100) return 'pct-ok';
            if (p >= 70) return 'pct-warn';
            return 'pct-bad';
          }
          function barColor(p) {
            if (p == null) return '#9ca3af';
            if (p >= 100) return '#16a34a';
            if (p >= 70) return '#d97706';
            return '#b91c1c';
          }
          const DOMAINS = [
            { key: 'agua', title: 'Água — ETA', sub: 'Estação de Tratamento', icon: 'droplet-fill',
              grad: ['#1e40af', '#2B286F'], statLbl: 'Registros hoje', secLbl: 'Locais ativos',
              statIcon: 'clipboard-data', secIcon: 'geo-alt', rankTitle: 'Top locais (30 dias)' },
            { key: 'gas', title: 'Gás', sub: 'Abastecimento', icon: 'cloud-fog2',
              grad: ['#92400e', '#d97706'], statLbl: 'Leituras hoje', secLbl: 'Fornecedores ativos',
              statIcon: 'clipboard-data', secIcon: 'truck', rankTitle: 'Top fornecedores (30 dias)' },
            { key: 'filtros', title: 'Filtros', sub: 'Operações', icon: 'funnel-fill',
              grad: ['#16a34a', '#059669'], statLbl: 'Operações hoje', secLbl: 'Equipamentos ativos',
              statIcon: 'clipboard-data', secIcon: 'hdd-stack', rankTitle: 'Top equipamentos (30 dias)' },
          ];
        %>
        <div class="painel-grid">
          <% DOMAINS.forEach(function(dom) {
               const d = stats[dom.key];
          %>
          <div class="painel-card">
            <div class="painel-head" style="background:linear-gradient(135deg,<%=dom.grad[0]%>,<%=dom.grad[1]%>);">
              <div class="painel-head-icon"><i class="bi bi-<%=dom.icon%>"></i></div>
              <div>
                <div class="painel-head-title"><%=dom.title%></div>
                <div class="painel-head-sub"><%=dom.sub%></div>
              </div>
            </div>
            <div class="painel-body">
              <% if (!d) { %>
                <div class="painel-empty">Sem dados disponíveis.</div>
              <% } else { %>
                <div class="painel-stats">
                  <div class="painel-stat">
                    <div class="painel-stat-icon" style="background:rgba(43,40,111,.1);color:#2B286F;">
                      <i class="bi bi-<%=dom.statIcon%>"></i>
                    </div>
                    <div>
                      <div class="painel-stat-val"><%=fmtInt(d.hoje)%></div>
                      <div class="painel-stat-lbl"><%=dom.statLbl%></div>
                    </div>
                  </div>
                  <div class="painel-stat">
                    <div class="painel-stat-icon" style="background:rgba(43,40,111,.1);color:#2B286F;">
                      <i class="bi bi-<%=dom.secIcon%>"></i>
                    </div>
                    <div>
                      <div class="painel-stat-val"><%=fmtInt(d.secundario)%></div>
                      <div class="painel-stat-lbl"><%=dom.secLbl%></div>
                    </div>
                  </div>
                </div>

                <div class="painel-pct-row">
                  <span class="painel-pct-lbl">vs média 7 dias</span>
                  <span class="painel-pct-badge <%=pctClass(d.pctMedia)%>">
                    <%= d.pctMedia == null ? '—' : d.pctMedia + '%' %>
                  </span>
                </div>
                <div class="painel-progress">
                  <div class="painel-progress-bar" style="width:<%= d.pctMedia == null ? 0 : Math.min(d.pctMedia,100) %>%;background:<%=barColor(d.pctMedia)%>;"></div>
                </div>

                <div class="painel-mes">
                  <div class="painel-mes-pct"><%= d.pctMes == null ? '—' : d.pctMes + '%' %></div>
                  <div>
                    <div class="painel-mes-lbl">Performance do mês</div>
                    <div class="painel-mes-nums">Real: <%=fmtInt(d.mesAtual)%> · Mês anterior: <%=fmtInt(d.mesAnterior)%></div>
                  </div>
                </div>

                <div class="painel-rank-title"><%=dom.rankTitle%></div>
                <% if (!d.ranking.length) { %>
                  <div class="painel-empty">Sem registros no período.</div>
                <% } else { %>
                  <% d.ranking.forEach(function(r) { %>
                    <div class="painel-rank-row">
                      <span class="painel-rank-label"><%=r.label%></span>
                      <span class="painel-rank-val"><%=fmtInt(r.total)%></span>
                    </div>
                  <% }); %>
                  <div class="painel-rank-row painel-rank-total">
                    <span class="painel-rank-label">Total</span>
                    <span class="painel-rank-val"><%=fmtInt(d.totalRanking)%></span>
                  </div>
                <% } %>
              <% } %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
