<!DOCTYPE html>
<html>
<head>
  <title>Portal ETE — Início</title>
  <%- include('../System/headIncludes.ejs') %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
  <style>
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
      gap: .65rem;
      margin-bottom: 1.2rem;
    }
    .kpi-card {
      border-radius: 10px;
      padding: 14px 16px;
      color: white;
      box-shadow: 0 3px 10px rgba(0,0,0,0.13);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .kpi-val  { font-size: 1.7rem; font-weight: 700; line-height: 1; letter-spacing: -.5px; }
    .kpi-unit { font-size: .72rem; opacity: .85; font-weight: 500; margin-left: 2px; }
    .kpi-lbl  { font-size: .72rem; opacity: .88; letter-spacing: .2px; }
    .kpi-sub  { font-size: .68rem; opacity: .75; }
    .kpi-mob-only    { display: none; }
    .kpi-hide-mobile { display: none !important; }   
    @media (min-width: 768px) { .kpi-grid { display: none; } } 
    .chart-wrap { position: relative; height: 260px; }

    @media (max-width: 767px) {
      .kpi-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: .45rem;
        margin-bottom: .75rem;
      }
      .kpi-card { padding: 9px 10px; border-radius: 8px; }
      .kpi-val  { font-size: 1.15rem; }
      .kpi-lbl  { font-size: .64rem; }
      .kpi-sub  { display: none; }
      .kpi-hide-mobile { display: none !important; }
      .kpi-mob-only    { display: flex !important; }
      .chart-wrap { height: 175px; }
    }
  </style>
</head>
<body>
  <div class="layout-container">
    <%- include('../partials/sidebar') %>
    <div class="main-content">
      <%- include('../partials/topbar', { pageTitle: 'Início', pageIcon: 'house', username: username }) %>

      <div class="content">

        <%
          const s  = stats;
          const ud = s.ultimoDia;
          function fv(v) {
            if (v == null || v === 0) return '—';
            return Number(v).toFixed(2);
          }
          function statusBg(v, min, max) {
            if (v == null || v === 0) return ['#64748b','#94a3b8'];
            if (min != null && max != null) {
              if (v >= min && v <= max) return ['#166534','#16a34a'];
              if (v < min * 0.85 || v > max * 1.15) return ['#991b1b','#b91c1c'];
              return ['#92400e','#d97706'];
            }
            return ['#1e40af','#2B286F'];
          }
          const KPIS = [
            { lbl:'pH',          unit:'',     v: ud && ud.pH,          min:6.5,  max:9.5  },
            { lbl:'Turbidez',    unit:'uT',   v: ud && ud.Turbidez,    min:0,    max:1.0  },
            { lbl:'Ferro',       unit:'mg/L', v: ud && ud.Ferro,       min:0,    max:0.3  },
            { lbl:'Cor',         unit:'uH',   v: ud && ud.Cor,         min:0,    max:15   },
            { lbl:'Cloro',       unit:'mg/L', v: ud && ud.Cloro,       min:0.2,  max:5.0  },
            { lbl:'Alcalinidade',unit:'mg/L', v: ud && ud.Alcalinidade,min:null, max:null },
            { lbl:'Dureza',      unit:'mg/L', v: ud && ud.Dureza,      min:null, max:null },
          ];
        %>
        <div class="kpi-grid">
          <% KPIS.forEach(function(k) { const bg = statusBg(k.v, k.min, k.max); %>
          <div class="kpi-card kpi-hide-mobile" style="background:linear-gradient(135deg,<%=bg[0]%>,<%=bg[1]%>);">
            <div><span class="kpi-val"><%=fv(k.v)%></span><span class="kpi-unit"><%=k.unit%></span></div>
            <div class="kpi-lbl"><%=k.lbl%></div>
            <% if(k.min!=null){%><div class="kpi-sub">Ref: <%=k.min%>–<%=k.max%></div><%}%>
          </div>
          <% }); %>
          <% if(s.conformidade){%>
          <div class="kpi-card kpi-hide-mobile" style="background:linear-gradient(135deg,#065f46,#059669);">
            <div><span class="kpi-val"><%=s.conformidade.ph_conf||'—'%></span><span class="kpi-unit">%</span></div>
            <div class="kpi-lbl">pH conf.</div>
            <div class="kpi-sub">Portaria 888</div>
          </div>
          <div class="kpi-card kpi-hide-mobile" style="background:linear-gradient(135deg,#0369a1,#0ea5e9);">
            <div><span class="kpi-val"><%=s.conformidade.ferro_conf||'—'%></span><span class="kpi-unit">%</span></div>
            <div class="kpi-lbl">Ferro conf.</div>
            <div class="kpi-sub">≤ 0,3 mg/L</div>
          </div>
          <%}%>
          <% if(ud){%>
          <div class="kpi-card kpi-hide-mobile" style="background:linear-gradient(135deg,#1e40af,#2B286F);">
            <div><span class="kpi-val"><%=ud.qtd%></span></div>
            <div class="kpi-lbl">Registros</div>
            <div class="kpi-sub"><%=ud.Data%> · <%=ud.locais%> locais</div>
          </div>
          <div class="kpi-card kpi-mob-only" style="background:linear-gradient(135deg,<%=statusBg(ud.pH,6.5,9.5)[0]%>,<%=statusBg(ud.pH,6.5,9.5)[1]%>);">
            <div class="kpi-lbl" style="opacity:.8;">pH médio</div>
            <div style="font-size:1.15rem;font-weight:700;margin-top:4px;"><%=fv(ud.pH)%></div>
          </div>
          <div class="kpi-card kpi-mob-only" style="background:linear-gradient(135deg,#1e40af,#2B286F);">
            <div class="kpi-lbl" style="opacity:.8;">Últ. medição</div>
            <div style="font-size:1rem;font-weight:700;margin-top:4px;"><%=ud.Data%></div>
            <div style="font-size:.68rem;opacity:.75;"><%=ud.qtd%> registros · <%=ud.locais%> locais</div>
          </div>
          <%}%>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-12 col-lg-8">
            <div class="card chart-card">
              <div class="card-header"><i class="bi bi-graph-up me-2"></i>Tendência de qualidade — últimas medições</div>
              <div class="card-body p-2"><div class="chart-wrap"><canvas id="chartTrend"></canvas></div></div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-lg-4">
            <div class="card chart-card">
              <div class="card-header"><i class="bi bi-clock me-2"></i>Registros por turno</div>
              <div class="card-body p-2"><div class="chart-wrap"><canvas id="chartTurno"></canvas></div></div>
            </div>
          </div>
        </div>
        <div class="row g-3">
          <div class="col-12 col-sm-6 col-lg-6">
            <div class="card chart-card">
              <div class="card-header"><i class="bi bi-bar-chart me-2"></i>Registros por dia</div>
              <div class="card-body p-2"><div class="chart-wrap"><canvas id="chartRegistros"></canvas></div></div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-lg-6">
            <div class="card chart-card">
              <div class="card-header"><i class="bi bi-distribute-vertical me-2"></i>Distribuição de pH</div>
              <div class="card-body p-2"><div class="chart-wrap"><canvas id="chartPHDist"></canvas></div></div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
  <script>
  (function () {
    const S = <%- statsJson %>;

    const FONT = { size: 11, family: "'Inter','Segoe UI',sans-serif" };
    Chart.defaults.font = FONT;
    Chart.defaults.color = '#555';

    function baseOpts(title) {
      return {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'top', labels: { boxWidth: 11, font: FONT, padding: 10 } },
          tooltip: { mode: 'index', intersect: false },
        },
      };
    }

    function breakGaps(arr, maxDays) {
      if (!arr || !arr.length) return arr;
      const out = [];
      for (let i = 0; i < arr.length; i++) {
        out.push(arr[i]);
        if (i < arr.length - 1) {
          const gap = (new Date(arr[i+1].dia) - new Date(arr[i].dia)) / 86400000;
          if (gap > maxDays) out.push({ dia: null, ph: null, turbidez: null, cor: null, ferro: null, registros: null });
        }
      }
      return out;
    }
    const trendData = breakGaps(S.trend, 14);

    if (trendData && trendData.length) {
      const labels = trendData.map(r => r.dia || '');
      new Chart(document.getElementById('chartTrend'), {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'pH',
              data: trendData.map(r => r.ph != null ? +r.ph.toFixed(2) : null),
              borderColor: '#2B286F', backgroundColor: 'rgba(43,40,111,.1)',
              tension: .35, fill: true, pointRadius: 3, yAxisID: 'yPH', spanGaps: true,
            },
            {
              label: 'Turbidez (uT)',
              data: trendData.map(r => r.turbidez != null ? +r.turbidez.toFixed(2) : null),
              borderColor: '#d97706', backgroundColor: 'rgba(217,119,6,.08)',
              tension: .35, fill: false, pointRadius: 3, yAxisID: 'yTurb', spanGaps: true,
            },
            {
              label: 'Cor (uH)',
              data: trendData.map(r => r.cor != null ? +r.cor.toFixed(2) : null),
              borderColor: '#7c3aed', backgroundColor: 'rgba(124,58,237,.08)',
              tension: .35, fill: false, pointRadius: 2, borderDash: [4,3], yAxisID: 'yTurb', spanGaps: true,
            },
          ],
        },
        options: {
          ...baseOpts(),
          interaction: { mode: 'index', intersect: false },
          scales: {
            x: { ticks: { font: FONT, maxTicksLimit: 10 }, grid: { color: '#f0f0f0' } },
            yPH: {
              type: 'linear', position: 'left',
              title: { display: true, text: 'pH', font: FONT },
              min: 5.5, max: 10,
              ticks: { font: FONT },
              grid: { color: '#f0f0f0' },
            },
            yTurb: {
              type: 'linear', position: 'right',
              title: { display: true, text: 'uT / uH', font: FONT },
              min: 0,
              ticks: { font: FONT },
              grid: { drawOnChartArea: false },
            },
          },
        },
      });
    }

    if (S.byTurno && S.byTurno.length) {
      new Chart(document.getElementById('chartTurno'), {
        type: 'doughnut',
        data: {
          labels: S.byTurno.map(r => r.turno),
          datasets: [{
            data: S.byTurno.map(r => r.total),
            backgroundColor: ['#16a34a','#d97706','#2B286F','#64748b'],
            borderWidth: 2, borderColor: '#fff',
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { boxWidth: 12, font: FONT, padding: 12 } },
            tooltip: { callbacks: {
              label: ctx => ` ${ctx.label}: ${ctx.parsed} (${Math.round(ctx.parsed/S.totalGeral*100)}%)`,
            }},
          },
          cutout: '62%',
        },
      });
    }

    if (trendData && trendData.length) {
      new Chart(document.getElementById('chartRegistros'), {
        type: 'bar',
        data: {
          labels: trendData.map(r => r.dia || ''),
          datasets: [{
            label: 'Registros',
            data: trendData.map(r => r.registros),
            backgroundColor: 'rgba(43,40,111,.75)',
            borderColor: '#2B286F',
            borderWidth: 1, borderRadius: 4,
          }],
        },
        options: {
          ...baseOpts(),
          plugins: { legend: { display: false } },
          scales: {
            x: { ticks: { font: FONT, maxTicksLimit: 12 }, grid: { display: false } },
            y: { ticks: { font: FONT, stepSize: 1 }, beginAtZero: true, grid: { color: '#f0f0f0' } },
          },
        },
      });
    }

    if (S.phDist && S.phDist.length) {
      const inRange = ['6,5–7,0','7,0–7,5','7,5–8,0','8,0–8,5','8,5–9,5'];
      new Chart(document.getElementById('chartPHDist'), {
        type: 'bar',
        data: {
          labels: S.phDist.map(r => r.faixa),
          datasets: [{
            label: 'Medições',
            data: S.phDist.map(r => r.total),
            backgroundColor: S.phDist.map(r =>
              inRange.includes(r.faixa) ? 'rgba(22,163,74,.75)' : 'rgba(185,28,28,.75)'
            ),
            borderColor: S.phDist.map(r =>
              inRange.includes(r.faixa) ? '#16a34a' : '#b91c1c'
            ),
            borderWidth: 1, borderRadius: 4,
          }],
        },
        options: {
          ...baseOpts(),
          plugins: {
            legend: { display: false },
            tooltip: { callbacks: {
              label: ctx => ` ${ctx.parsed.y} medições`,
              afterLabel: ctx => {
                const pct = Math.round(ctx.parsed.y / S.totalGeral * 100);
                const ok = inRange.includes(ctx.label);
                return ` ${pct}% do total · ${ok ? '✓ conforme' : '⚠ fora do padrão'}`;
              },
            }},
          },
          scales: {
            x: { ticks: { font: FONT }, grid: { display: false } },
            y: { ticks: { font: FONT, stepSize: 1 }, beginAtZero: true, grid: { color: '#f0f0f0' } },
          },
        },
      });
    }
  })();
  </script>
</body>
</html>
