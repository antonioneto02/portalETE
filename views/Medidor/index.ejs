<!DOCTYPE html>
<html>
<head>
  <title>Portal ETE — Medidor ETA</title>
  <%- include('../System/headIncludes.ejs') %>
  <style>
    /* ── Tabela ── */
    .badge-turno { font-size:.72rem; padding:3px 8px; border-radius:10px; }
    .dt-compact td, .dt-compact th { padding:6px 8px !important; font-size:.82rem; }
    .dt-compact th { white-space:nowrap; }
    .val-ok  { color:#16a34a; font-weight:600; }
    .val-warn{ color:#d97706; font-weight:600; }
    .val-bad { color:#b91c1c; font-weight:600; }
    .btn-excel { background:#16a34a !important; color:white !important; border:none !important; }
    .btn-excel:hover { background:#15803d !important; }
    #tblMedidor_filter { display:flex !important; flex-wrap:wrap; align-items:center; gap:.4rem; }
    #tblMedidor_filter label { display:none; }
    @media (max-width:767px) {
      #tblMedidor_filter input[type=search] { width:90px !important; min-width:70px !important; font-size:.75rem !important; }
    }

    /* ── Modal ── */
    .modal-fullscreen-sm-down { max-height:100dvh; }
    #medidorModal .modal-body { overflow-y:auto; max-height:calc(100dvh - 140px); padding:16px; }

    /* ── Seções do formulário ── */
    .form-section {
      background:#f8fafc;
      border:1px solid #e9edf2;
      border-radius:8px;
      padding:14px 14px 8px;
      margin-bottom:14px;
    }
    .form-section-title {
      display:flex; align-items:center; gap:7px;
      font-size:.7rem; font-weight:700; color:#2B286F;
      text-transform:uppercase; letter-spacing:.6px;
      border-left:3px solid #2B286F;
      padding:3px 8px; margin-bottom:12px;
      background:rgba(43,40,111,.06);
      border-radius:0 4px 4px 0;
    }
    .form-section-title i { font-size:.85rem; }

    /* ── Labels ── */
    .param-pair { display:flex; flex-direction:column; }
    .param-pair label {
      font-size:.7rem; font-weight:600;
      color:#6b7280; margin-bottom:3px;
      text-transform:uppercase; letter-spacing:.35px;
    }
    .param-pair .req { color:#D11F3F; }

    /* ── Inputs e Selects: mesma aparência ── */
    .param-pair .form-control,
    .param-pair .form-select {
      font-size:.875rem;
      color:#111827;
      border:1.5px solid #d1d5db;
      border-radius:6px;
      padding:.38rem .7rem;
      height:36px;
      background-color:#fff;
      box-shadow:none;
      transition:border-color .15s, box-shadow .15s;
    }
    .param-pair .form-select {
      padding-right:2rem;          /* espaço pro chevron */
      background-position:right .55rem center;
      background-size:14px 10px;
    }
    .param-pair textarea.form-control {
      height:auto; min-height:72px; resize:vertical;
    }
    .param-pair .form-control:focus,
    .param-pair .form-select:focus {
      border-color:#2B286F;
      box-shadow:0 0 0 .18rem rgba(43,40,111,.18);
      outline:none;
    }
    .param-pair .form-control::placeholder { color:#9ca3af; font-style:italic; }

    /* ── Par valor/aparelho lado a lado ── */
    .param-group {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:8px;
      align-items:end;
    }
    @media (max-width:480px) { .param-group { grid-template-columns:1fr; } }

    /* ── Alerta no form ── */
    #formAlert { font-size:.875rem; }
  </style>
</head>
<body>
  <div class="layout-container">
    <%- include('../partials/sidebar') %>
    <div class="main-content">
      <%- include('../partials/topbar', { pageTitle: 'Medidor ETA', pageIcon: 'speedometer2', username: username }) %>

      <div class="content">
        <% if (dbError) { %>
          <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i><%= dbError %></div>
        <% } %>

        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="bi bi-table me-2"></i>Lançamentos ETA</span>
            <button class="btn btn-sm" id="btnCadastrar"
              style="background:linear-gradient(135deg,#2B286F,#4a47a3);color:white;border:none;">
              <i class="bi bi-plus-lg me-1"></i>Cadastrar
            </button>
          </div>
          <div class="card-body p-0 p-md-3">
            <div style="overflow-x:auto;">
              <table id="tblMedidor" class="table table-striped table-hover dt-compact w-100">
                <thead>
                  <tr>
                    <th>Data</th>
                    <th>Turno</th>
                    <th>Operador</th>
                    <th>Local</th>
                    <th>pH</th>
                    <th>Cloro</th>
                    <th>Turbidez</th>
                    <th>Cor</th>
                    <th>Alcalinidade</th>
                    <th>Ferro</th>
                    <th>Dureza</th>
                    <th class="d-none d-lg-table-cell">Aspecto</th>
                    <th class="d-none d-lg-table-cell">Inicial</th>
                    <th class="d-none d-lg-table-cell">Final</th>
                    <th class="d-none d-lg-table-cell">OBS</th>
                  </tr>
                </thead>
                <tbody>
                <% lancamentos.forEach(function(l) {
                  // Divisor adaptativo: >=100 → ÷100, 10-99 → ÷10, <10 → ÷1
                  function adapt(v) {
                    if(v==null||v==='') return null;
                    const n = Number(v);
                    if(n>=100) return n/100;
                    if(n>=10)  return n/10;
                    return n;
                  }
                  function fmt(v) { const n=adapt(v); return n==null?'—':n.toFixed(2); }
                  function fmtDate(d) {
                    if(!d) return '—';
                    try { return new Date(d).toLocaleDateString('pt-BR'); } catch(e){ return String(d).substring(0,10); }
                  }
                  function turnoLabel(t) { return t===1?'Manhã':t===2?'Tarde':t===3?'Noite':t||'—'; }
                  function cls(raw, min, max) {
                    const v = adapt(raw);
                    if(v==null) return '';
                    if(min!=null&&max!=null){ if(v>=min&&v<=max)return 'val-ok'; if(v<min*0.8||v>max*1.2)return 'val-bad'; return 'val-warn'; }
                    return '';
                  }
                %>

                  <tr>
                    <td><%= fmtDate(l.Data) %></td>
                    <td>
                      <% if(l.turno) { %>
                        <span class="badge-turno" style="background:<%= l.turno===1?'#16a34a':l.turno===2?'#d97706':'#2B286F' %>;color:white;">
                          <%= turnoLabel(l.turno) %>
                        </span>
                      <% } else { %>—<% } %>
                    </td>
                    <td><%= l.Operador||'—' %></td>
                    <td><%= l.LOCAL||'—' %></td>
                    <td class="<%= cls(l.pH,6.5,9.5) %>"><%= fmt(l.pH) %></td>
                    <td class="<%= cls(l.Cloro,0.2,5.0) %>"><%= fmt(l.Cloro) %></td>
                    <td class="<%= cls(l.Turbidez,0,1.0) %>"><%= fmt(l.Turbidez) %></td>
                    <td class="<%= cls(l.Cor_Visual,0,15) %>"><%= fmt(l.Cor_Visual) %></td>
                    <td><%= fmt(l.Alcalinidade) %></td>
                    <td class="<%= cls(l.Ferro,0,0.3) %>"><%= fmt(l.Ferro) %></td>
                    <td><%= fmt(l.Dureza) %></td>
                    <td class="d-none d-lg-table-cell"><%= l.Aspecto_Visual||'—' %></td>
                    <td class="d-none d-lg-table-cell"><%= l.Inicial||'—' %></td>
                    <td class="d-none d-lg-table-cell"><%= l.Final||'—' %></td>
                    <td class="d-none d-lg-table-cell" style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= l.OBS||'—' %></td>
                  </tr>
                <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Cadastrar -->
  <div class="modal fade" id="medidorModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-fullscreen-sm-down">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Novo Lançamento ETA</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="formMedidor" novalidate>
            <input type="hidden" name="_csrf" id="csrfInput" value="<%= csrfToken %>">

            <!-- ① Identificação -->
            <div class="form-section">
              <div class="form-section-title"><i class="bi bi-person-badge"></i>Identificação</div>
              <div class="row g-2">
                <div class="col-6 col-md-3 param-pair">
                  <label for="fData">Data <span class="req">*</span></label>
                  <input type="date" class="form-control" id="fData" name="Data" required>
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="fTurno">Turno <span class="req">*</span></label>
                  <select class="form-select" id="fTurno" name="turno" required>
                    <option value="">— Selecione —</option>
                    <option>Manhã</option>
                    <option>Tarde</option>
                    <option>Noite</option>
                  </select>
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="fMatricula">Matrícula</label>
                  <input type="text" class="form-control" id="fMatricula" name="matricula" placeholder="Ex: 000123">
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="fOperador">Operador</label>
                  <input type="text" class="form-control" id="fOperador" name="Operador" placeholder="Nome completo">
                </div>
                <div class="col-12 col-md-5 param-pair">
                  <label for="fLocal">Local / Ponto de coleta</label>
                  <input type="text" class="form-control" id="fLocal" name="LOCAL" placeholder="Ex: ETA 01 — Polidor">
                </div>
                <div class="col-6 col-md-2 param-pair">
                  <label for="fInicial">Início</label>
                  <input type="time" class="form-control" id="fInicial" name="Inicial">
                </div>
                <div class="col-6 col-md-2 param-pair">
                  <label for="fFinal">Fim</label>
                  <input type="time" class="form-control" id="fFinal" name="Final">
                </div>
                <div class="col-6 col-md-2 param-pair">
                  <label for="fLigado">Ligado</label>
                  <input type="time" class="form-control" id="fLigado" name="Ligado">
                </div>
                <div class="col-6 col-md-1 param-pair">
                  <label for="fDeligado">Deslig.</label>
                  <input type="time" class="form-control" id="fDeligado" name="Deligado">
                </div>
              </div>
            </div>

            <!-- ② Aspectos Físicos -->
            <div class="form-section">
              <div class="form-section-title"><i class="bi bi-eye"></i>Aspectos Físicos</div>
              <div class="row g-2">
                <div class="col-12 col-md-5 param-pair">
                  <label for="fAspecto">Aspecto visual</label>
                  <select class="form-select" id="fAspecto" name="Aspecto_Visual">
                    <option value="">— Selecione —</option>
                    <option>Límpido</option>
                    <option>Turvo</option>
                    <option>Amarelado</option>
                    <option>Esverdeado</option>
                    <option>Sem Cor</option>
                  </select>
                </div>
                <div class="col-12 col-md-7">
                  <div class="param-group">
                    <div class="param-pair">
                      <label for="fCorVis">Cor visual <span style="color:#9ca3af;font-weight:400">(uH)</span></label>
                      <input type="number" step="0.01" min="0" class="form-control" id="fCorVis" name="Cor_Visual" placeholder="0">
                    </div>
                    <div class="param-pair">
                      <label for="fVisualAp">Aparelho / Leitura</label>
                      <input type="text" class="form-control" id="fVisualAp" name="Visual_Aparelho" placeholder="Modelo ou valor">
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- ③ Parâmetros Químicos -->
            <div class="form-section">
              <div class="form-section-title"><i class="bi bi-droplet-half"></i>Parâmetros Químicos</div>
              <div class="row g-2">

                <div class="col-12 col-md-6">
                  <div class="param-group">
                    <div class="param-pair">
                      <label for="fpH">pH <span style="color:#9ca3af;font-weight:400">(6,5–9,5)</span></label>
                      <input type="number" step="0.01" min="0" max="14" class="form-control" id="fpH" name="pH" placeholder="7.00">
                    </div>
                    <div class="param-pair">
                      <label for="fpHAp">pH — aparelho</label>
                      <input type="text" class="form-control" id="fpHAp" name="pH_Aparelho" placeholder="Modelo/ID">
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <div class="param-group">
                    <div class="param-pair">
                      <label for="fCloro">Cloro <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                      <input type="number" step="0.01" min="0" class="form-control" id="fCloro" name="Cloro" placeholder="0.20">
                    </div>
                    <div class="param-pair">
                      <label for="fCloroAp">Cloro — aparelho</label>
                      <input type="text" class="form-control" id="fCloroAp" name="Cloro_Aparelho" placeholder="Modelo/ID">
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <div class="param-group">
                    <div class="param-pair">
                      <label for="fTurb">Turbidez <span style="color:#9ca3af;font-weight:400">(uT)</span></label>
                      <input type="number" step="0.01" min="0" class="form-control" id="fTurb" name="Turbidez" placeholder="0.00">
                    </div>
                    <div class="param-pair">
                      <label for="fTurbAp">Turbidez — aparelho</label>
                      <input type="text" class="form-control" id="fTurbAp" name="Turbidez_Aparelho" placeholder="Modelo/ID">
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <div class="param-group">
                    <div class="param-pair">
                      <label for="fAlc">Alcalinidade <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                      <input type="number" step="0.01" min="0" class="form-control" id="fAlc" name="Alcalinidade" placeholder="0.00">
                    </div>
                    <div class="param-pair">
                      <label for="fAlcAp">Alcalinidade — aparelho</label>
                      <input type="text" class="form-control" id="fAlcAp" name="Alcalinidade_Aparelho" placeholder="Modelo/ID">
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <div class="param-group">
                    <div class="param-pair">
                      <label for="fFerro">Ferro <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                      <input type="number" step="0.001" min="0" class="form-control" id="fFerro" name="Ferro" placeholder="0.000">
                    </div>
                    <div class="param-pair">
                      <label for="fFerroAp">Ferro — aparelho</label>
                      <input type="text" class="form-control" id="fFerroAp" name="Ferro_Aparelho" placeholder="Modelo/ID">
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <div class="param-group">
                    <div class="param-pair">
                      <label for="fDureza">Dureza <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                      <input type="number" step="0.01" min="0" class="form-control" id="fDureza" name="Dureza" placeholder="0.00">
                    </div>
                    <div class="param-pair">
                      <label for="fDurezaAp">Dureza — aparelho</label>
                      <input type="text" class="form-control" id="fDurezaAp" name="Dureza_Aparelho" placeholder="Modelo/ID">
                    </div>
                  </div>
                </div>

              </div>
            </div>

            <!-- ④ Observações -->
            <div class="form-section">
              <div class="form-section-title"><i class="bi bi-chat-left-text"></i>Observações</div>
              <div class="param-pair">
                <label for="fObs">Ocorrências / Anotações do turno</label>
                <textarea class="form-control" id="fObs" name="OBS" rows="3"
                  placeholder="Descreva ocorrências, anomalias ou observações relevantes..."></textarea>
              </div>
            </div>

            <div id="formAlert" class="alert mt-2" style="display:none;"></div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn" id="btnSalvar"
            style="background:linear-gradient(135deg,#2B286F,#4a47a3);color:white;border:none;min-width:110px;">
            <span id="btnSalvarTxt"><i class="bi bi-check-lg me-1"></i>Salvar</span>
            <span id="btnSalvarLoad" style="display:none;">
              <span class="spinner-border spinner-border-sm me-1"></span>Salvando...
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS (modal) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
  $(document).ready(function () {

    // DataTable
    var isMobile = window.innerWidth <= 767;
    $('#tblMedidor').DataTable({
      language: {
        url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
      },
      order: [[0, 'desc']],
      pageLength: isMobile ? 10 : 25,
      scrollX: !isMobile,
      dom: '<"d-flex flex-wrap gap-2 align-items-center mb-2"Blf>rtip',
      buttons: [
        {
          extend: 'excelHtml5',
          text: '<i class="bi bi-file-earmark-excel me-1"></i>Excel',
          className: 'btn btn-sm btn-excel',
          title: 'Lançamentos ETA',
        },
      ],
      initComplete: function () {
        dtBuildFilters(this.api(), 'tblMedidor_filter', [
          { idx: 1, label: 'Turno...',    w: '110px' },
          { idx: 2, label: 'Operador...', w: '140px' },
          { idx: 3, label: 'Local...',    w: '120px' },
          { idx: 0, label: 'Data...',     w: '120px' },
        ]);
      },
    });

    // Pré-preenche data de hoje
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('fData').value = today;

    const modal = new bootstrap.Modal(document.getElementById('medidorModal'));
    document.getElementById('btnCadastrar').addEventListener('click', () => modal.show());

    document.getElementById('btnSalvar').addEventListener('click', async function () {
      const form = document.getElementById('formMedidor');
      const alertEl = document.getElementById('formAlert');

      // Validação básica
      if (!form.Data.value || !form.turno.value) {
        showAlert('Por favor, preencha Data e Turno.', 'danger');
        return;
      }

      setBusy(true);
      alertEl.style.display = 'none';

      const body = {};
      new FormData(form).forEach((v, k) => { body[k] = v; });

      try {
        const resp = await fetch('/medidor/cadastrar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const json = await resp.json();
        if (json.success) {
          showAlert('Lançamento salvo com sucesso!', 'success');
          if (json.csrfToken) document.getElementById('csrfInput').value = json.csrfToken;
          form.reset();
          document.getElementById('fData').value = today;
          setTimeout(() => { modal.hide(); location.reload(); }, 1200);
        } else {
          showAlert(json.error || 'Erro ao salvar.', 'danger');
        }
      } catch {
        showAlert('Falha na comunicação com o servidor.', 'danger');
      } finally {
        setBusy(false);
      }
    });

    function setBusy(on) {
      document.getElementById('btnSalvarTxt').style.display  = on ? 'none'         : 'inline';
      document.getElementById('btnSalvarLoad').style.display = on ? 'inline-block'  : 'none';
      document.getElementById('btnSalvar').disabled = on;
    }

    function showAlert(msg, type) {
      const el = document.getElementById('formAlert');
      el.className = 'alert alert-' + type + ' mt-3';
      el.textContent = msg;
      el.style.display = 'block';
      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });
  </script>
</body>
</html>
