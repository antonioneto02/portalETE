<!DOCTYPE html>
<html>
<head>
  <title>Portal ETE — Medidor ETA</title>
  <%- include('../System/headIncludes.ejs') %>
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <style>
    .badge-turno { font-size:.72rem; padding:3px 8px; border-radius:10px; }
    .dt-compact td, .dt-compact th { padding:6px 8px !important; font-size:.82rem; }
    .dt-compact th { white-space:nowrap; }
    .val-ok  { color:#16a34a; font-weight:600; }
    .val-warn{ color:#d97706; font-weight:600; }
    .val-bad { color:#b91c1c; font-weight:600; }
    .btn-excel { background:#16a34a !important; color:white !important; border:none !important; }
    .btn-excel:hover { background:#15803d !important; }
    @media (max-width:767px) { .dt-buttons { display:none !important; } }
    #tblMedidor_filter { display:flex !important; flex-wrap:wrap; align-items:center; gap:.4rem; }
    #tblMedidor_filter label { display:none !important; }
    @media (max-width:767px) {
      #tblMedidor_filter { display:grid !important; grid-template-columns:1fr 1fr; gap:.3rem; width:100%; }
      #tblMedidor_filter > div { width:100% !important; display:block !important; }
      #tblMedidor_filter > div input { width:100% !important; min-width:0 !important; box-sizing:border-box; }
    }

    #tblMedidor_wrapper > div[style*="overflow-x"]::-webkit-scrollbar { height: 7px; }
    #tblMedidor_wrapper > div[style*="overflow-x"]::-webkit-scrollbar-track { background: #f3f4f6; border-radius: 4px; }
    #tblMedidor_wrapper > div[style*="overflow-x"]::-webkit-scrollbar-thumb { background: #9ca3af; border-radius: 4px; }
    #tblMedidor_wrapper > div[style*="overflow-x"]::-webkit-scrollbar-thumb:hover { background: #6b7280; }
    @media (max-width:767px) {
      #tblMedidor_filter { gap:.3rem; }
    }

    .mob-toolbar { margin-bottom:12px; }
    .mob-search { position:relative; margin-bottom:10px; }
    .mob-search i {
      position:absolute; left:12px; top:50%; transform:translateY(-50%);
      color:#9ca3af; font-size:.9rem;
    }
    .mob-search input {
      width:100%; height:42px; border:1.5px solid #e9edf2; border-radius:10px;
      padding:0 12px 0 36px; font-size:.85rem; background:#fff;
      box-shadow:0 1px 3px rgba(0,0,0,.04);
    }
    .mob-search input:focus { outline:none; border-color:#2B286F; box-shadow:0 0 0 .15rem rgba(43,40,111,.15); }
    .mob-chips {
      display:flex; gap:6px; overflow-x:auto; -webkit-overflow-scrolling:touch;
      padding-bottom:2px; scrollbar-width:none;
    }
    .mob-chips::-webkit-scrollbar { display:none; }
    .mob-chip {
      flex-shrink:0; border:1.5px solid #e9edf2; background:#fff; color:#6b7280;
      font-size:.74rem; font-weight:600; padding:6px 12px; border-radius:20px;
      display:flex; align-items:center; gap:5px; white-space:nowrap;
    }
    .mob-chip-count {
      background:rgba(0,0,0,.06); color:inherit; font-size:.66rem; font-weight:700;
      padding:1px 6px; border-radius:10px;
    }
    .mob-chip.mob-chip-active { border-color:#2B286F; background:#2B286F; color:#fff; }
    .mob-chip.mob-chip-active .mob-chip-count { background:rgba(255,255,255,.22); color:#fff; }
    .mob-chip[data-filter="bad"].mob-chip-active  { border-color:#dc2626; background:#dc2626; }
    .mob-chip[data-filter="warn"].mob-chip-active { border-color:#d97706; background:#d97706; }
    .mob-chip[data-filter="ok"].mob-chip-active   { border-color:#16a34a; background:#16a34a; }

    .mobile-reg-card {
      background:#fff; border:1px solid #e9edf2; border-left:4px solid #d1d5db; border-radius:10px;
      padding:12px 14px; margin-bottom:10px; box-shadow:0 1px 4px rgba(0,0,0,.05);
    }
    .mobile-reg-card.status-bad  { border-left-color:#dc2626; }
    .mobile-reg-card.status-warn { border-left-color:#d97706; }
    .mobile-reg-card.status-ok   { border-left-color:#16a34a; }
    .mrc-row { display:flex; align-items:center; gap:10px; cursor:pointer; }
    .mrc-icon {
      width:38px; height:38px; border-radius:10px; flex-shrink:0;
      background:rgba(43,40,111,.08); color:#2B286F;
      display:flex; align-items:center; justify-content:center; font-size:1.05rem;
    }
    .mrc-main { flex:1; min-width:0; }
    .mrc-title { font-weight:700; font-size:.9rem; color:#1f2430; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .mrc-sub { font-size:.74rem; color:#6b7280; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:1px; }
    .mrc-side { display:flex; align-items:center; gap:8px; flex-shrink:0; }
    .mrc-chip { font-size:.68rem; font-weight:700; padding:4px 9px; border-radius:20px; white-space:nowrap; }
    .mrc-chip.val-ok   { background:rgba(22,163,74,.12); color:#16a34a; }
    .mrc-chip.val-warn { background:rgba(217,119,6,.12); color:#d97706; }
    .mrc-chip.val-bad  { background:rgba(220,38,38,.12); color:#dc2626; }
    .mrc-chip.val-none { background:#f1f3f5; color:#9ca3af; }
    .mrc-chevron { font-size:.8rem; color:#9ca3af; transition:transform .2s; }
    .mobile-reg-card.open .mrc-chevron { transform:rotate(180deg); }
    .mrc-details { display:none; margin-top:10px; padding-top:10px; border-top:1px solid #f1f3f5; }
    .mobile-reg-card.open .mrc-details { display:block; }
    .mrc-subhead {
      font-size:.65rem; font-weight:700; color:#2B286F; text-transform:uppercase; letter-spacing:.4px;
      margin:10px 0 6px;
    }
    .mrc-subhead:first-child { margin-top:0; }
    .mrc-grid {
      display:grid; grid-template-columns:1fr 1fr; gap:8px;
      padding-bottom:8px; border-bottom:1px solid #f1f3f5;
    }
    .mrc-item { display:flex; flex-direction:column; }
    .mrc-lbl { font-size:.62rem; text-transform:uppercase; letter-spacing:.4px; color:#9ca3af; font-weight:600; }
    .mrc-val { font-size:.82rem; color:#1f2430; font-weight:600; }
    .mrc-obs { margin-top:8px; font-size:.78rem; color:#6b7280; font-style:italic; }
    .mrc-empty { text-align:center; color:#9ca3af; padding:36px 0; font-size:.85rem; }

    .modal-fullscreen-md-down { max-height:100dvh; }
    @media (max-width:767px) {
      #medidorModal .modal-dialog { transition: transform .25s ease-out !important; }
      #medidorModal.fade .modal-dialog { transform: translateY(100%) !important; }
      #medidorModal.show .modal-dialog { transform: translateY(0) !important; }
      #medidorModal .modal-footer { gap:8px; }
      #medidorModal .modal-footer .btn { flex:1; }
      #medidorModal #btnSalvar { flex:1.4; }
    }
    #medidorModal .modal-body { overflow-y:auto; max-height:calc(100dvh - 140px); padding:16px; }
    #medidorModal .select2-container { width:100% !important; }
    #medidorModal .select2-container--default .select2-selection--single {
      height:36px;
      border:1.5px solid #d1d5db;
      border-radius:6px;
      padding:.38rem .7rem;
      background:#fff;
      transition:border-color .15s, box-shadow .15s;
    }
    #medidorModal .select2-container--default.select2-container--focus .select2-selection--single,
    #medidorModal .select2-container--default.select2-container--open .select2-selection--single {
      border-color:#2B286F;
      box-shadow:0 0 0 .18rem rgba(43,40,111,.18);
      outline:none;
    }
    #medidorModal .select2-container--default .select2-selection--single .select2-selection__rendered {
      line-height:1.5; padding:0; color:#111827; font-size:.875rem;
    }
    #medidorModal .select2-container--default .select2-selection--single .select2-selection__placeholder {
      color:#9ca3af;
    }
    #medidorModal .select2-container--default .select2-selection--single .select2-selection__arrow {
      height:34px; right:6px;
    }
    #medidorModal .select2-container--default .select2-selection--single .select2-selection__clear {
      margin-right:14px; color:#9ca3af; font-size:1rem;
    }
    .select2-dropdown { z-index:9999; border:1.5px solid #d1d5db; border-radius:6px; font-size:.875rem; }
    .select2-container--default .select2-results__option--highlighted { background:#2B286F !important; }
    .select2-search--dropdown .select2-search__field {
      border:1px solid #d1d5db; border-radius:4px; padding:4px 8px; font-size:.85rem;
    }

    .form-section {
      background:#f8fafc;
      border:1px solid #e9edf2;
      border-radius:8px;
      padding:14px 14px 8px;
      margin-bottom:14px;
    }
    .form-section-title {
      display:flex; align-items:center; gap:7px;
      font-size:.7rem; font-weight:700; color:#2B286F;
      text-transform:uppercase; letter-spacing:.6px;
      border-left:3px solid #2B286F;
      padding:3px 8px; margin-bottom:12px;
      background:rgba(43,40,111,.06);
      border-radius:0 4px 4px 0;
    }
    .form-section-title i { font-size:.85rem; }
    .param-pair { display:flex; flex-direction:column; }
    .param-pair label {
      font-size:.7rem; font-weight:600;
      color:#6b7280; margin-bottom:3px;
      text-transform:uppercase; letter-spacing:.35px;
    }
    .param-pair .req { color:#D11F3F; }
    .param-pair .form-control,
    .param-pair .form-select {
      font-size:.875rem;
      color:#111827;
      border:1.5px solid #d1d5db;
      border-radius:6px;
      padding:.38rem .7rem;
      height:36px;
      background-color:#fff;
      box-shadow:none;
      transition:border-color .15s, box-shadow .15s;
    }
    .param-pair .form-select {
      padding-right:2rem;        
      background-position:right .55rem center;
      background-size:14px 10px;
    }
    .param-pair textarea.form-control {
      height:auto; min-height:72px; resize:vertical;
    }
    .param-pair .form-control:focus,
    .param-pair .form-select:focus {
      border-color:#2B286F;
      box-shadow:0 0 0 .18rem rgba(43,40,111,.18);
      outline:none;
    }
    .param-pair .form-control::placeholder { color:#9ca3af; font-style:normal; }
    .param-group {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:8px;
      align-items:end;
    }
    @media (max-width:480px) { .param-group { grid-template-columns:1fr; } }
    #formAlert { font-size:.875rem; }
  </style>
</head>
<body>
  <div class="layout-container">
    <%- include('../partials/sidebar') %>
    <div class="main-content">
      <%- include('../partials/topbar', { pageTitle: 'Medidor ETA', pageIcon: 'speedometer2', username: username }) %>
      <%- include('../partials/bottomnav') %>

      <div class="content">
        <% if (dbError) { %>
          <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i><%= dbError %></div>
        <% } %>

        <ul class="nav nav-tabs medidor-tabs" id="medidorTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-agua-btn" data-bs-toggle="tab" data-bs-target="#tab-agua" type="button" role="tab" aria-controls="tab-agua" aria-selected="true">
              <i class="bi bi-droplet-half me-1"></i>Água
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-gas-btn" data-bs-toggle="tab" data-bs-target="#tab-gas" type="button" role="tab" aria-controls="tab-gas" aria-selected="false">
              <i class="bi bi-cloud-fog2 me-1"></i>Gás
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-filtro-btn" data-bs-toggle="tab" data-bs-target="#tab-filtro" type="button" role="tab" aria-controls="tab-filtro" aria-selected="false">
              <i class="bi bi-funnel me-1"></i>Filtros
            </button>
          </li>
        </ul>

        <div class="tab-content" id="medidorTabsContent">
        <div class="tab-pane fade show active" id="tab-agua" role="tabpanel" aria-labelledby="tab-agua-btn">
        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="bi bi-table me-2"></i>Lançamentos ETA</span>
            <button class="btn btn-sm d-none d-md-inline-flex" id="btnCadastrar"
              style="background:linear-gradient(135deg,#2B286F,#4a47a3);color:white;border:none;">
              <i class="bi bi-plus-lg me-1"></i>Leitura
            </button>
          </div>
          <div class="card-body p-0 p-md-3">
            <%
              function raw(v) {
                if(v==null||v==='') return null;
                return Number(v);
              }
              function fmtNum(n, decimals) {
                return n==null?'—':n.toLocaleString('pt-BR',{minimumFractionDigits:decimals||2,maximumFractionDigits:decimals||2});
              }
              function fmtRaw(v) { return fmtNum(raw(v)); }
              function fmtDate(d) {
                if(!d) return '—';
                try {
                  const dt = new Date(d);
                  const day   = String(dt.getUTCDate()).padStart(2,'0');
                  const month = String(dt.getUTCMonth()+1).padStart(2,'0');
                  return day + '/' + month + '/' + dt.getUTCFullYear();
                } catch(e){ return String(d).substring(0,10); }
              }
              function fmtDateTime(d) {
                if(!d) return '—';
                try {
                  const dt = new Date(d);
                  return dt.toLocaleDateString('pt-BR') + ' ' + dt.toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'});
                } catch(e){ return String(d); }
              }
              function fmtInt(v) { return (v==null||v==='') ? '—' : v; }
              function turnoLabel(t) { return t===1?'Manhã':t===2?'Tarde':t===3?'Noite':t||'—'; }
              function cls(v, min, max) {
                if(v==null) return '';
                if(min!=null&&max!=null){ if(v>=min&&v<=max)return 'val-ok'; if(v<min*0.8||v>max*1.2)return 'val-bad'; return 'val-warn'; }
                return '';
              }
              function overallStatus(l) {
                const classes = [
                  cls(raw(l.pH),6.5,9.5), cls(raw(l.Cloro),0.2,5.0), cls(raw(l.Turbidez),0,1.0),
                  cls(raw(l.Ferro),0,0.3), cls(raw(l.Cor_Visual),0,15),
                ].filter(Boolean);
                if (!classes.length) return 'none';
                if (classes.includes('val-bad'))  return 'bad';
                if (classes.includes('val-warn')) return 'warn';
                return 'ok';
              }
            %>
            <div class="d-none d-md-block" style="overflow-x:auto;-webkit-overflow-scrolling:touch;width:100%;">
              <table id="tblMedidor" class="table table-striped table-hover dt-compact w-100">
                <thead>
                  <tr>
                    <th>Data</th>
                    <th>Turno</th>
                    <th>Operador</th>
                    <th>Matrícula</th>
                    <th>Local</th>
                    <th>Aspecto</th>
                    <th>Cor</th>
                    <th>pH</th>
                    <th>Cloro</th>
                    <th>Turbidez</th>
                    <th>Alcalinidade</th>
                    <th>Ferro</th>
                    <th>Dureza</th>
                    <th>Condutividade</th>
                    <th>Início</th>
                    <th>Início Descanso</th>
                    <th>Fim Descanso</th>
                    <th>Ligado</th>
                    <th>Desligado</th>
                    <th>OBS</th>
                    <th>Cadastro</th>
                    <th>Alteração</th>
                    <th class="no-export">Ações</th>
                  </tr>
                </thead>
                <tbody>
                <% lancamentos.forEach(function(l) { %>
                  <tr data-id="<%= l.ID %>">
                    <td data-order="<%= l.Data ? new Date(l.Data).getTime() : 0 %>"><%= fmtDate(l.Data) %></td>
                    <td>
                      <% if(l.turno) { %>
                        <span class="badge-turno" style="background:<%= l.turno===1?'#16a34a':l.turno===2?'#d97706':'#2B286F' %>;color:white;">
                          <%= turnoLabel(l.turno) %>
                        </span>
                      <% } else { %>—<% } %>
                    </td>
                    <td><%= l.Operador||'—' %></td>
                    <td><%= l.matricula||'—' %></td>
                    <td><%= l.LOCAL||'—' %></td>
                    <td><%= l.Aspecto_Visual||'—' %></td>
                    <td class="<%= cls(raw(l.Cor_Visual),0,15) %>"><%= fmtRaw(l.Cor_Visual) %></td>
                    <td class="<%= cls(raw(l.pH),6.5,9.5) %>"><%= fmtRaw(l.pH) %></td>
                    <td class="<%= cls(raw(l.Cloro),0.2,5.0) %>"><%= fmtRaw(l.Cloro) %></td>
                    <td class="<%= cls(raw(l.Turbidez),0,1.0) %>"><%= fmtRaw(l.Turbidez) %></td>
                    <td><%= fmtRaw(l.Alcalinidade) %></td>
                    <td class="<%= cls(raw(l.Ferro),0,0.3) %>"><%= fmtRaw(l.Ferro) %></td>
                    <td><%= fmtRaw(l.Dureza) %></td>
                    <td><%= fmtRaw(l.Condutividade) %></td>
                    <td><%= fmtInt(l.Inicial) %></td>
                    <td><%= fmtDateTime(l.Inicio_Descanso) %></td>
                    <td><%= fmtDateTime(l.Fim_Descanso) %></td>
                    <td><%= l.Ligado||'—' %></td>
                    <td><%= l.Desligado||'—' %></td>
                    <td style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= l.OBS||'—' %></td>
                    <td><%= fmtDateTime(l.DataCadastro) %></td>
                    <td><%= fmtDateTime(l.DataAlteracao) %></td>
                    <td class="no-export">
                      <button type="button" class="btn btn-sm btn-outline-secondary btn-edit-lancamento" data-id="<%= l.ID %>" title="Editar">
                        <i class="bi bi-pencil"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
                </tbody>
              </table>
            </div>

            <div class="d-block d-md-none p-3" id="mobileCardList">
              <div class="mob-toolbar">
                <div class="mob-search">
                  <i class="bi bi-search"></i>
                  <input type="text" id="mobileSearchInput" placeholder="Buscar local, operador...">
                </div>
                <div class="mob-chips">
                  <button type="button" class="mob-chip mob-chip-active" data-filter="todos">
                    Todos <span class="mob-chip-count" id="cntTodos">0</span>
                  </button>
                  <button type="button" class="mob-chip" data-filter="bad">
                    <i class="bi bi-exclamation-circle"></i> Alerta <span class="mob-chip-count" id="cntBad">0</span>
                  </button>
                  <button type="button" class="mob-chip" data-filter="warn">
                    <i class="bi bi-clock-history"></i> Atenção <span class="mob-chip-count" id="cntWarn">0</span>
                  </button>
                  <button type="button" class="mob-chip" data-filter="ok">
                    <i class="bi bi-check-circle"></i> Conforme <span class="mob-chip-count" id="cntOk">0</span>
                  </button>
                </div>
              </div>

              <% if (!lancamentos.length) { %>
                <div class="mrc-empty"><i class="bi bi-inbox d-block mb-2" style="font-size:1.6rem;"></i>Nenhum lançamento encontrado.</div>
              <% } %>

              <% lancamentos.forEach(function(l) {
                const searchStr = ((l.LOCAL||'') + ' ' + (l.Operador||'') + ' ' + (l.matricula||'')).toLowerCase();
                const status = overallStatus(l);
                const statusLabel = { bad:'Alerta', warn:'Atenção', ok:'Conforme', none:'—' }[status];
                const statusChipCls = { bad:'val-bad', warn:'val-warn', ok:'val-ok', none:'val-none' }[status];
              %>
                <div class="mobile-reg-card status-<%= status %>" data-search="<%= searchStr %>" data-status="<%= status %>" data-id="<%= l.ID %>">
                  <div class="mrc-row">
                    <div class="mrc-icon"><i class="bi bi-droplet-half"></i></div>
                    <div class="mrc-main">
                      <div class="mrc-title"><%= l.LOCAL||'—' %></div>
                      <div class="mrc-sub"><%= fmtDate(l.Data) %> · <%= turnoLabel(l.turno) %> · <%= l.Operador||'—' %></div>
                    </div>
                    <div class="mrc-side">
                      <span class="mrc-chip <%= statusChipCls %>"><%= statusLabel %></span>
                      <i class="bi bi-chevron-down mrc-chevron"></i>
                    </div>
                  </div>
                  <div class="mrc-details">
                    <div class="mrc-subhead">Parâmetros Medidos</div>
                    <div class="mrc-grid">
                      <div class="mrc-item"><span class="mrc-lbl">Aspecto Visual</span><span class="mrc-val"><%= l.Aspecto_Visual||'—' %></span></div>
                      <div class="mrc-item"><span class="mrc-lbl">Cor (uH)</span><span class="mrc-val"><%= fmtRaw(l.Cor_Visual) %></span></div>
                      <div class="mrc-item"><span class="mrc-lbl">pH</span><span class="mrc-val"><%= fmtRaw(l.pH) %></span></div>
                      <div class="mrc-item"><span class="mrc-lbl">Cloro (mg/L)</span><span class="mrc-val"><%= fmtRaw(l.Cloro) %></span></div>
                      <div class="mrc-item"><span class="mrc-lbl">Turbidez (uT)</span><span class="mrc-val"><%= fmtRaw(l.Turbidez) %></span></div>
                      <div class="mrc-item"><span class="mrc-lbl">Alcalinidade</span><span class="mrc-val"><%= fmtRaw(l.Alcalinidade) %></span></div>
                      <div class="mrc-item"><span class="mrc-lbl">Ferro (mg/L)</span><span class="mrc-val"><%= fmtRaw(l.Ferro) %></span></div>
                      <div class="mrc-item"><span class="mrc-lbl">Dureza</span><span class="mrc-val"><%= fmtRaw(l.Dureza) %></span></div>
                      <div class="mrc-item"><span class="mrc-lbl">Condutividade</span><span class="mrc-val"><%= fmtRaw(l.Condutividade) %></span></div>
                    </div>
                    <div class="mrc-subhead">Horários</div>
                    <div class="mrc-grid">
                      <div class="mrc-item"><span class="mrc-lbl">Início</span><span class="mrc-val"><%= fmtInt(l.Inicial) %></span></div>
                      <div class="mrc-item"><span class="mrc-lbl">Início Descanso</span><span class="mrc-val"><%= fmtDateTime(l.Inicio_Descanso) %></span></div>
                      <div class="mrc-item"><span class="mrc-lbl">Fim Descanso</span><span class="mrc-val"><%= fmtDateTime(l.Fim_Descanso) %></span></div>
