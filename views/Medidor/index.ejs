    // Composer inline (mesmo padrão "clique para criar uma nota" das Anotações do Central de Tarefas)
    const turnoNewPlaceholder = document.getElementById('turnoNewPlaceholder');
    const turnoNewExpanded = document.getElementById('turnoNewExpanded');
    const turnoNewContent = document.getElementById('turnoNewContent');

    function expandTurnoComposer() {
      turnoNewPlaceholder.style.display = 'none';
      turnoNewExpanded.classList.remove('hidden');
      turnoNewContent.focus();
    }

    function collapseTurnoComposer() {
      turnoNewContent.value = '';
      document.getElementById('formAlertTurnoInline').style.display = 'none';
      turnoNewExpanded.classList.add('hidden');
      turnoNewPlaceholder.style.display = 'block';
    }

    turnoNewPlaceholder.addEventListener('click', expandTurnoComposer);

    document.addEventListener('click', function (e) {
      if (!turnoNewExpanded.classList.contains('hidden') &&
          !turnoNewExpanded.contains(e.target) && e.target !== turnoNewPlaceholder) {
        if (turnoNewContent.value.trim()) {
          saveTurnoInline();
        } else {
          collapseTurnoComposer();
        }
      }
    });

    document.getElementById('btnCancelarTurnoInline').addEventListener('click', collapseTurnoComposer);
    document.getElementById('btnSalvarTurnoInline').addEventListener('click', function () { saveTurnoInline(); });

    async function saveTurnoInline() {
      const texto = turnoNewContent.value.trim();
      const alertEl = document.getElementById('formAlertTurnoInline');
      if (!texto) { collapseTurnoComposer(); return; }

      const btn = document.getElementById('btnSalvarTurnoInline');
      btn.disabled = true;
      alertEl.style.display = 'none';

      try {
        const resp = await fetch('/medidor/turno/cadastrar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ _csrf: document.getElementById('csrfInputTurno').value, Texto: texto }),
        });
        const json = await resp.json();
        if (json.success) {
          location.hash = 'tab-turno';
          location.reload();
        } else {
          alertEl.className = 'alert alert-danger';
          alertEl.textContent = json.error || 'Erro ao salvar.';
          alertEl.style.display = 'block';
        }
      } catch {
        alertEl.className = 'alert alert-danger';
        alertEl.textContent = 'Falha na comunicação com o servidor.';
        alertEl.style.display = 'block';
      } finally {
        btn.disabled = false;
      }
    }

    let pendingModalToClose = null;
    function wireCancelConfirm(btnId, formId, modalInstance) {
      document.getElementById(btnId).addEventListener('click', function() {
        const form = document.getElementById(formId);
        const preenchido = Array.from(form.elements).some(el =>
          el.type !== 'hidden' && el.name !== '_csrf' && el.readOnly !== true && el.value && el.value !== ''
        );
        if (preenchido) {
          pendingModalToClose = modalInstance;
          modalConfirma.show();
        } else {
          modalInstance.hide();
        }
      });
    }
    wireCancelConfirm('btnCancelar', 'formMedidor', modal);
    wireCancelConfirm('btnCancelarGas', 'formGas', gasModal);
    wireCancelConfirm('btnCancelarFiltro', 'formFiltro', filtroModal);
    wireCancelConfirm('btnCancelarConsumo', 'formConsumo', consumoModal);
    wireCancelConfirm('btnCancelarTurno', 'formTurno', turnoModal);

