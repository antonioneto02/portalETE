                <div class="col-6 col-md-4 param-pair">
                  <label for="gFornecedor">Fornecedor <span class="req">*</span></label>
                  <select class="form-control" id="gFornecedor" name="Fornecedor" required>
                    <option value="">— Selecione —</option>
                    <option>IBG</option>
                    <option>White Martins</option>
                  </select>
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="gLeitura">Leitura</label>
                  <input type="number" class="form-control" id="gLeitura" name="Leitura" placeholder="0">
                </div>
                <div class="col-6 col-md-3 param-pair" id="gapGasWrap" style="display:none;">
                  <label for="gGapGas">Gap</label>
                  <input type="text" class="form-control" id="gGapGas" readonly
                    style="background:#f3f4f6;cursor:not-allowed;color:#6b7280;">
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="gPressao">Pressão</label>
                  <input type="number" class="form-control" id="gPressao" name="Pressao" placeholder="0">
                </div>
              </div>
            </div>
            <div id="formAlertGas" class="alert mt-2" style="display:none;"></div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" id="btnCancelarGas">Cancelar</button>
          <button type="button" class="btn" id="btnSalvarGas"
            style="background:linear-gradient(135deg,#2B286F,#4a47a3);color:white;border:none;min-width:110px;">
            <span id="btnSalvarGasTxt"><i class="bi bi-check-lg me-1"></i>Salvar</span>
            <span id="btnSalvarGasLoad" style="display:none;">
              <span class="spinner-border spinner-border-sm me-1"></span>Salvando...
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="filtroModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-fullscreen-md-down">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="filtroModalTitle"><i class="bi bi-plus-circle me-2"></i>Nova Leitura de Filtro</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="formFiltro" novalidate>
            <input type="hidden" name="_csrf" id="csrfInputFiltro" value="<%= csrfToken %>">
            <input type="hidden" name="ID" id="fltId" value="">
            <div class="form-section">
              <div class="form-section-title"><i class="bi bi-funnel"></i>Leitura de Filtro</div>
              <div class="row g-2">
                <div class="col-6 col-md-6 param-pair">
                  <label for="fltFiltro">Filtro <span class="req">*</span></label>
                  <select class="form-control" id="fltFiltro" name="Filtro" required>
                    <option value="">— Selecione —</option>
                    <option>Areia Novo</option>
                    <option>Areia</option>
                    <option>Abrandador VEXER</option>
                    <option>Abrandador</option>
                  </select>
                </div>
                <div class="col-6 col-md-6 param-pair">
                  <label for="fltTipo">Tipo</label>
                  <input type="text" class="form-control" id="fltTipo" name="Tipo" readonly
                    placeholder="Auto"
                    style="background:#f3f4f6;cursor:not-allowed;color:#6b7280;">
                </div>
              </div>
            </div>
            <div class="form-section" id="filtroGroupRetro" style="display:none;">
              <div class="form-section-title"><i class="bi bi-droplet-half"></i>Retrolavagem</div>
              <div class="row g-2">
                <div class="col-6 col-md-4 param-pair">
                  <label for="fltTurb">Turbidez <span style="color:#9ca3af;font-weight:400">(uT)</span></label>
                  <input type="text" inputmode="decimal" class="form-control input-decimal" id="fltTurb" name="Turbidez" data-decimals="2" placeholder="0,00">
                </div>
                <div class="col-6 col-md-4 param-pair">
                  <label for="fltCor">Cor <span style="color:#9ca3af;font-weight:400">(uH)</span></label>
                  <input type="text" inputmode="decimal" class="form-control input-decimal" id="fltCor" name="Cor" data-decimals="1" placeholder="0,0">
                </div>
              </div>
            </div>
            <div class="form-section" id="filtroGroupRegen" style="display:none;">
              <div class="form-section-title"><i class="bi bi-droplet-half"></i>Regeneramento</div>
              <div class="row g-2">
                <div class="col-6 col-md-4 param-pair">
                  <label for="fltAlc">Alcalinidade <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                  <input type="text" inputmode="decimal" class="form-control input-decimal" id="fltAlc" name="Alcalinidade" data-decimals="1" placeholder="0,0">
                </div>
                <div class="col-6 col-md-4 param-pair">
                  <label for="fltDureza">Dureza <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                  <input type="text" inputmode="decimal" class="form-control input-decimal" id="fltDureza" name="Dureza" data-decimals="1" placeholder="0,0">
                </div>
              </div>
            </div>
            <div id="formAlertFiltro" class="alert mt-2" style="display:none;"></div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" id="btnCancelarFiltro">Cancelar</button>
          <button type="button" class="btn" id="btnSalvarFiltro"
            style="background:linear-gradient(135deg,#2B286F,#4a47a3);color:white;border:none;min-width:110px;">
            <span id="btnSalvarFiltroTxt"><i class="bi bi-check-lg me-1"></i>Salvar</span>
            <span id="btnSalvarFiltroLoad" style="display:none;">
              <span class="spinner-border spinner-border-sm me-1"></span>Salvando...
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
  const lancamentosData = {};
  <%- JSON.stringify(lancamentos) %>.forEach(function (l) { lancamentosData[l.ID] = l; });

  const lancamentosGasData = {};
  <%- JSON.stringify(lancamentosGas) %>.forEach(function (g) { lancamentosGasData[g.ID] = g; });

  const lancamentosFiltroData = {};
  <%- JSON.stringify(lancamentosFiltro) %>.forEach(function (f) { lancamentosFiltroData[f.ID] = f; });

  const FILTRO_TIPO_MAP = {
    'Areia Novo':       'Retrolavagem',
    'Areia':            'Retrolavagem',
    'Abrandador VEXER': 'Regeneramento',
    'Abrandador':       'Regeneramento',
  };

  function maskDecimalInput(el) {
    const decimals = parseInt(el.dataset.decimals || '2', 10);
    el.addEventListener('input', function () {
      let digits = el.value.replace(/\D/g, '').replace(/^0+(?=\d)/, '');
      if (!digits) { el.value = ''; return; }
      while (digits.length <= decimals) digits = '0' + digits;
      const intPart = digits.slice(0, digits.length - decimals).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
      const decPart = digits.slice(digits.length - decimals);
      el.value = intPart + ',' + decPart;
    });
  }
  function decimalToFloatStr(v) {
    if (!v) return '';
    return v.replace(/\./g, '').replace(',', '.');
  }
  function fmtDecimalInput(v, decimals) {
    if (v == null || v === '') return '';
    const d = decimals != null ? decimals : 2;
    return Number(v).toLocaleString('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d });
  }
  function toDatetimeLocalValue(v) {
    if (!v) return '';
    const dt = new Date(v);
    const pad = n => String(n).padStart(2, '0');
    return dt.getFullYear() + '-' + pad(dt.getMonth() + 1) + '-' + pad(dt.getDate()) + 'T' + pad(dt.getHours()) + ':' + pad(dt.getMinutes());
  }

  $(document).ready(function () {
    var isMobile = window.innerWidth <= 767;
    document.querySelectorAll('.input-decimal').forEach(maskDecimalInput);
    $('#tblMedidor').DataTable({
      language: {
        url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
      },
      order: [[0, 'desc']],
      pageLength: isMobile ? 10 : 25,
      scrollX: false,
      dom: '<"d-flex flex-wrap gap-2 align-items-center mb-2"Bf>rtip<"mt-1"l>',
      buttons: [
        {
          extend: 'excelHtml5',
          text: '<i class="bi bi-file-earmark-excel me-1"></i>Excel',
          className: 'btn btn-sm btn-excel',
          title: 'Lançamentos ETA',
          exportOptions: { columns: ':not(.no-export)' },
        },
      ],
      initComplete: function () {
        dtBuildFilters(this.api(), 'tblMedidor_filter', [
          { idx: 1, label: 'Turno...',    w: '110px' },
          { idx: 2, label: 'Operador...', w: '140px' },
          { idx: 4, label: 'Local...',    w: '120px' },
          { idx: 0, label: 'Data...',     w: '120px' },
        ]);
      },
    });

    const tblGasInstance = $('#tblGas').DataTable({
      language: {
        url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
      },
      order: [[0, 'desc']],
      pageLength: isMobile ? 10 : 25,
      scrollX: false,
      dom: '<"d-flex flex-wrap gap-2 align-items-center mb-2"f>rtip<"mt-1"l>',
    });

    const tblFiltroInstance = $('#tblFiltro').DataTable({
      language: {
        url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
      },
      order: [[0, 'desc']],
      pageLength: isMobile ? 10 : 25,
      scrollX: false,
      dom: '<"d-flex flex-wrap gap-2 align-items-center mb-2"f>rtip<"mt-1"l>',
    });

    function setFabVisibility(activeTab) {
      document.getElementById('btnCadastrarMobile').classList.toggle('d-none', activeTab !== 'agua');
      const gasFab = document.getElementById('btnCadastrarGasMobile');
      if (gasFab) gasFab.classList.toggle('d-none', activeTab !== 'gas');
      const filtroFab = document.getElementById('btnCadastrarFiltroMobile');
      if (filtroFab) filtroFab.classList.toggle('d-none', activeTab !== 'filtro');
    }
    document.getElementById('tab-agua-btn').addEventListener('shown.bs.tab', function () {
      setFabVisibility('agua');
    });
    document.getElementById('tab-gas-btn').addEventListener('shown.bs.tab', function () {
      setFabVisibility('gas');
      tblGasInstance.columns.adjust();
    });
    document.getElementById('tab-filtro-btn').addEventListener('shown.bs.tab', function () {
      setFabVisibility('filtro');
      tblFiltroInstance.columns.adjust();
    });

    if (window.location.hash === '#tab-gas') {
      bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-gas-btn')).show();
    }
    if (window.location.hash === '#tab-filtro') {
      bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-filtro-btn')).show();
    }

    (function initMobileCardList() {
      const mobileSearchInput = document.getElementById('mobileSearchInput');
      const cards = document.querySelectorAll('#mobileCardList .mobile-reg-card');
      const emptyMsg = document.getElementById('mobileEmptyMsg');
      const chips = document.querySelectorAll('.mob-chip');
      if (!cards.length) return;

      const counts = { bad: 0, warn: 0, ok: 0, none: 0 };
      cards.forEach(function (card) {
        if (counts[card.dataset.status] !== undefined) counts[card.dataset.status]++;
      });
      const setCount = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
      setCount('cntTodos', cards.length);
      setCount('cntBad', counts.bad);
      setCount('cntWarn', counts.warn);
      setCount('cntOk', counts.ok);

      let activeFilter = 'todos';

      function applyFilters() {
        const term = mobileSearchInput ? mobileSearchInput.value.trim().toLowerCase() : '';
        let visibleCount = 0;
        cards.forEach(function (card) {
          const matchesSearch = !term || card.dataset.search.includes(term);
          const matchesFilter = activeFilter === 'todos' || card.dataset.status === activeFilter;
          const show = matchesSearch && matchesFilter;
          card.style.display = show ? '' : 'none';
          if (show) visibleCount++;
        });
        if (emptyMsg) emptyMsg.style.display = visibleCount ? 'none' : 'block';
      }

      if (mobileSearchInput) mobileSearchInput.addEventListener('input', applyFilters);

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          chips.forEach(c => c.classList.remove('mob-chip-active'));
          chip.classList.add('mob-chip-active');
          activeFilter = chip.dataset.filter;
          applyFilters();
        });
      });

      document.querySelectorAll('.mrc-row').forEach(function (row) {
        row.addEventListener('click', function () {
          row.closest('.mobile-reg-card').classList.toggle('open');
        });
      });
    })();

    (function initMobileCardListGas() {
      const container = document.getElementById('mobileCardListGas');
      if (!container) return;
      const mobileSearchInput = document.getElementById('mobileSearchInputGas');
      const cards = container.querySelectorAll('.mobile-reg-card');
      const emptyMsg = document.getElementById('mobileEmptyMsgGas');
      if (!cards.length) return;

      function applyFilters() {
        const term = mobileSearchInput ? mobileSearchInput.value.trim().toLowerCase() : '';
        let visibleCount = 0;
        cards.forEach(function (card) {
          const show = !term || card.dataset.search.includes(term);
          card.style.display = show ? '' : 'none';
          if (show) visibleCount++;
        });
        if (emptyMsg) emptyMsg.style.display = visibleCount ? 'none' : 'block';
      }

      if (mobileSearchInput) mobileSearchInput.addEventListener('input', applyFilters);
    })();

    (function initMobileCardListFiltro() {
      const container = document.getElementById('mobileCardListFiltro');
      if (!container) return;
      const mobileSearchInput = document.getElementById('mobileSearchInputFiltro');
      const cards = container.querySelectorAll('.mobile-reg-card');
      const emptyMsg = document.getElementById('mobileEmptyMsgFiltro');
      if (!cards.length) return;

      function applyFilters() {
        const term = mobileSearchInput ? mobileSearchInput.value.trim().toLowerCase() : '';
        let visibleCount = 0;
        cards.forEach(function (card) {
          const show = !term || card.dataset.search.includes(term);
          card.style.display = show ? '' : 'none';
          if (show) visibleCount++;
        });
        if (emptyMsg) emptyMsg.style.display = visibleCount ? 'none' : 'block';
      }

      if (mobileSearchInput) mobileSearchInput.addEventListener('input', applyFilters);
    })();

    const s2opts = { dropdownParent: $('#medidorModal'), allowClear: true, width: '100%' };
    $('#fTurno').select2({ ...s2opts, placeholder: '— Selecione —' });
    $('#fAspecto').select2({ ...s2opts, placeholder: '— Selecione —' });
    $('#fLocal').select2({ ...s2opts, placeholder: '— Selecione o local —' });

    const s2optsGas = { dropdownParent: $('#gasModal'), allowClear: true, width: '100%' };
    $('#gTipo').select2({ ...s2optsGas, placeholder: '— Selecione —' });
    $('#gFornecedor').select2({ ...s2optsGas, placeholder: '— Selecione —' });
    $('#gTipo').on('change', function () { updateGapGas(); });
    document.getElementById('gLeitura').addEventListener('input', updateGapGas);
    $('#fLocal').on('change', function () { updateGapAcumulo(); updateDescansoReadonly(); });
    document.getElementById('fInicial').addEventListener('input', updateGapAcumulo);

    const s2optsFiltro = { dropdownParent: $('#filtroModal'), allowClear: true, width: '100%' };
    $('#fltFiltro').select2({ ...s2optsFiltro, placeholder: '— Selecione —' });
    $('#fltFiltro').on('change', function () { updateFiltroTipo(); });

    const modal = new bootstrap.Modal(document.getElementById('medidorModal'));
    const gasModal = new bootstrap.Modal(document.getElementById('gasModal'));
    const filtroModal = new bootstrap.Modal(document.getElementById('filtroModal'));
    const modalConfirma = new bootstrap.Modal(document.getElementById('modalConfirmaCancelar'));
    document.getElementById('medidorModal').addEventListener('hide.bs.modal', () => {
      if (document.activeElement && document.getElementById('medidorModal').contains(document.activeElement)) {
        document.activeElement.blur();
      }
    });
    document.getElementById('gasModal').addEventListener('hide.bs.modal', () => {
      if (document.activeElement && document.getElementById('gasModal').contains(document.activeElement)) {
        document.activeElement.blur();
      }
    });
    document.getElementById('filtroModal').addEventListener('hide.bs.modal', () => {
      if (document.activeElement && document.getElementById('filtroModal').contains(document.activeElement)) {
        document.activeElement.blur();
      }
    });
    document.getElementById('modalConfirmaCancelar').addEventListener('hide.bs.modal', () => {
      if (document.activeElement && document.getElementById('modalConfirmaCancelar').contains(document.activeElement)) {
        document.activeElement.blur();
      }
    });

    function findLastAcumuloReading(excludeId) {
      let last = null;
      Object.values(lancamentosData).forEach(function (l) {
        if (l.LOCAL !== 'Acumulo' || l.Inicial == null) return;
        if (excludeId && String(l.ID) === String(excludeId)) return;
        if (!last || new Date(l.Data) > new Date(last.Data) || (new Date(l.Data).getTime() === new Date(last.Data).getTime() && l.ID > last.ID)) {
          last = l;
        }
      });
      return last;
    }

    function updateGapAcumulo() {
      const wrap = document.getElementById('gapAcumuloWrap');
      if ($('#fLocal').val() !== 'Acumulo') {
        wrap.style.display = 'none';
        return;
      }
      const leituraStr = document.getElementById('fInicial').value;
      const leitura = leituraStr !== '' ? parseInt(leituraStr, 10) : null;
      const last = findLastAcumuloReading(document.getElementById('fId').value);
      if (!last || leitura == null || isNaN(leitura)) {
        wrap.style.display = 'none';
        return;
      }
      wrap.style.display = '';
      const fGap = document.getElementById('fGapAcumulo');
      fGap.value = leitura - last.Inicial;
      fGap.title = 'Leitura anterior: ' + last.Inicial;
    }

    function findLastGasReading(tipo, excludeId) {
      let last = null;
      Object.values(lancamentosGasData).forEach(function (g) {
        if (g.Tipo !== tipo || g.Leitura == null) return;
        if (excludeId && String(g.ID) === String(excludeId)) return;
        if (!last || new Date(g.DataHora) > new Date(last.DataHora) || (new Date(g.DataHora).getTime() === new Date(last.DataHora).getTime() && g.ID > last.ID)) {
          last = g;
        }
      });
      return last;
    }

    function updateGapGas() {
      const wrap = document.getElementById('gapGasWrap');
      const tipo = $('#gTipo').val();
      if (!tipo) {
        wrap.style.display = 'none';
        return;
      }
      const leituraStr = document.getElementById('gLeitura').value;
      const leitura = leituraStr !== '' ? parseInt(leituraStr, 10) : null;
      const last = findLastGasReading(tipo, document.getElementById('gId').value);
      if (!last || leitura == null || isNaN(leitura)) {
        wrap.style.display = 'none';
        return;
      }
      wrap.style.display = '';
      const gGap = document.getElementById('gGapGas');
      gGap.value = leitura - last.Leitura;
      gGap.title = 'Leitura anterior: ' + last.Leitura;
    }

    function updateDescansoReadonly() {
      const isAcumulo = $('#fLocal').val() === 'Acumulo';
      [document.getElementById('fInicioDescanso'), document.getElementById('fFimDescanso')].forEach(function (el) {
        el.readOnly = isAcumulo;
        el.style.background = isAcumulo ? '#f3f4f6' : '#fff';
        el.style.cursor = isAcumulo ? 'not-allowed' : '';
        el.style.color = isAcumulo ? '#6b7280' : '';
      });
    }

    function updateFiltroTipo() {
      const filtro = $('#fltFiltro').val();
      const tipo = FILTRO_TIPO_MAP[filtro] || '';
      document.getElementById('fltTipo').value = tipo;

      const retroGroup = document.getElementById('filtroGroupRetro');
      const regenGroup = document.getElementById('filtroGroupRegen');
      const showRetro = tipo === 'Retrolavagem';
      const showRegen = tipo === 'Regeneramento';

      retroGroup.style.display = showRetro ? '' : 'none';
      regenGroup.style.display = showRegen ? '' : 'none';

      if (!showRetro) {
        document.getElementById('fltTurb').value = '';
        document.getElementById('fltCor').value = '';
      }
      if (!showRegen) {
        document.getElementById('fltAlc').value = '';
        document.getElementById('fltDureza').value = '';
      }
    }

    function resetFormToCreate() {
      const form = document.getElementById('formMedidor');
      form.reset();
      document.getElementById('fId').value = '';
      document.getElementById('medidorModalTitle').innerHTML = '<i class="bi bi-plus-circle me-2"></i>Novo Lançamento ETA';
      $('#fTurno').val('').trigger('change');
      $('#fAspecto').val('').trigger('change');
      $('#fLocal').val('').trigger('change');
      updateGapAcumulo();
      updateDescansoReadonly();
    }

    function openForEdit(id) {
      const l = lancamentosData[id];
      if (!l) return;

      resetFormToCreate();
      document.getElementById('fId').value = id;
      document.getElementById('medidorModalTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Editar Lançamento ETA';

      document.getElementById('fInicial').value = (l.Inicial != null) ? l.Inicial : '';
      document.getElementById('fInicioDescanso').value = toDatetimeLocalValue(l.Inicio_Descanso);
      document.getElementById('fFimDescanso').value = toDatetimeLocalValue(l.Fim_Descanso);
      document.getElementById('fLigado').value = l.Ligado || '';
      document.getElementById('fDesligado').value = l.Desligado || '';
      document.getElementById('fObs').value = l.OBS || '';

      const turnoLabel = { 1: 'Manhã', 2: 'Tarde', 3: 'Noite' }[l.turno] || '';
      $('#fTurno').val(turnoLabel).trigger('change');
      $('#fAspecto').val(l.Aspecto_Visual || '').trigger('change');
      $('#fLocal').val(l.LOCAL || '').trigger('change');

      document.getElementById('fCorVis').value        = fmtDecimalInput(l.Cor_Visual);
      document.getElementById('fpH').value             = fmtDecimalInput(l.pH);
      document.getElementById('fCloro').value          = fmtDecimalInput(l.Cloro);
      document.getElementById('fTurb').value           = fmtDecimalInput(l.Turbidez);
      document.getElementById('fAlc').value            = fmtDecimalInput(l.Alcalinidade);
      document.getElementById('fFerro').value          = fmtDecimalInput(l.Ferro);
      document.getElementById('fDureza').value         = fmtDecimalInput(l.Dureza);
      document.getElementById('fCondutividade').value  = fmtDecimalInput(l.Condutividade);

      updateGapAcumulo();
      updateDescansoReadonly();
      modal.show();
    }

    document.querySelectorAll('.btn-edit-lancamento').forEach(function (btn) {
      btn.addEventListener('click', function () { openForEdit(btn.dataset.id); });
    });

    document.getElementById('btnCadastrar').addEventListener('click', () => { resetFormToCreate(); modal.show(); });
    const btnCadastrarMobile = document.getElementById('btnCadastrarMobile');
    if (btnCadastrarMobile) {
      btnCadastrarMobile.addEventListener('click', () => { resetFormToCreate(); modal.show(); });
    }

    function resetGasFormToCreate() {
      const form = document.getElementById('formGas');
      form.reset();
      document.getElementById('gId').value = '';
      document.getElementById('gasModalTitle').innerHTML = '<i class="bi bi-plus-circle me-2"></i>Nova Leitura de Gás';
      $('#gTipo').val('').trigger('change');
      $('#gFornecedor').val('').trigger('change');
    }

    function openGasForEdit(id) {
      const g = lancamentosGasData[id];
      if (!g) return;

      resetGasFormToCreate();
      document.getElementById('gId').value = id;
      document.getElementById('gasModalTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Editar Leitura de Gás';

      $('#gTipo').val(g.Tipo || '').trigger('change');
      $('#gFornecedor').val(g.Fornecedor || '').trigger('change');
      document.getElementById('gLeitura').value = (g.Leitura != null) ? g.Leitura : '';
      document.getElementById('gPressao').value = (g.Pressao != null) ? g.Pressao : '';

      updateGapGas();
      gasModal.show();
    }

    document.querySelectorAll('.btn-edit-gas').forEach(function (btn) {
      btn.addEventListener('click', function () { openGasForEdit(btn.dataset.id); });
    });

    document.getElementById('btnCadastrarGas').addEventListener('click', () => { resetGasFormToCreate(); gasModal.show(); });
    const btnCadastrarGasMobile = document.getElementById('btnCadastrarGasMobile');
    if (btnCadastrarGasMobile) {
      btnCadastrarGasMobile.addEventListener('click', () => { resetGasFormToCreate(); gasModal.show(); });
    }

    function resetFiltroFormToCreate() {
      const form = document.getElementById('formFiltro');
      form.reset();
      document.getElementById('fltId').value = '';
      document.getElementById('filtroModalTitle').innerHTML = '<i class="bi bi-plus-circle me-2"></i>Nova Leitura de Filtro';
      $('#fltFiltro').val('').trigger('change');
    }

    function openFiltroForEdit(id) {
      const f = lancamentosFiltroData[id];
      if (!f) return;

      resetFiltroFormToCreate();
      document.getElementById('fltId').value = id;
      document.getElementById('filtroModalTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Editar Leitura de Filtro';

      $('#fltFiltro').val(f.Filtro || '').trigger('change');
      document.getElementById('fltTurb').value    = fmtDecimalInput(f.Turbidez, 2);
      document.getElementById('fltCor').value     = fmtDecimalInput(f.Cor, 1);
      document.getElementById('fltAlc').value     = fmtDecimalInput(f.Alcalinidade, 1);
      document.getElementById('fltDureza').value  = fmtDecimalInput(f.Dureza, 1);

      filtroModal.show();
    }

    document.querySelectorAll('.btn-edit-filtro').forEach(function (btn) {
      btn.addEventListener('click', function () { openFiltroForEdit(btn.dataset.id); });
    });

    document.getElementById('btnCadastrarFiltro').addEventListener('click', () => { resetFiltroFormToCreate(); filtroModal.show(); });
    const btnCadastrarFiltroMobile = document.getElementById('btnCadastrarFiltroMobile');
    if (btnCadastrarFiltroMobile) {
      btnCadastrarFiltroMobile.addEventListener('click', () => { resetFiltroFormToCreate(); filtroModal.show(); });
    }

    let pendingModalToClose = null;
    function wireCancelConfirm(btnId, formId, modalInstance) {
      document.getElementById(btnId).addEventListener('click', function() {
        const form = document.getElementById(formId);
        const preenchido = Array.from(form.elements).some(el =>
          el.type !== 'hidden' && el.name !== '_csrf' && el.readOnly !== true && el.value && el.value !== ''
        );
        if (preenchido) {
          pendingModalToClose = modalInstance;
          modalConfirma.show();
        } else {
          modalInstance.hide();
        }
      });
    }
    wireCancelConfirm('btnCancelar', 'formMedidor', modal);
    wireCancelConfirm('btnCancelarGas', 'formGas', gasModal);
    wireCancelConfirm('btnCancelarFiltro', 'formFiltro', filtroModal);

    document.getElementById('btnVoltarForm').addEventListener('click', () => modalConfirma.hide());
    document.getElementById('btnConfirmarSair').addEventListener('click', function() {
      modalConfirma.hide();
      if (pendingModalToClose) pendingModalToClose.hide();
    });

    function syncAllCsrfInputs(token) {
      document.getElementById('csrfInput').value = token;
      document.getElementById('csrfInputGas').value = token;
      document.getElementById('csrfInputFiltro').value = token;
    }

    document.getElementById('btnSalvar').addEventListener('click', async function () {
      const form = document.getElementById('formMedidor');
      const alertEl = document.getElementById('formAlert');
      if (!form.turno.value) {
        showAlert('Por favor, preencha o Turno.', 'danger');
        return;
      }

      setBusy(true);
      alertEl.style.display = 'none';

      const editId = document.getElementById('fId').value;
      const body = {};
      new FormData(form).forEach((v, k) => { body[k] = v; });
      form.querySelectorAll('.input-decimal').forEach(el => {
        body[el.name] = decimalToFloatStr(body[el.name]);
      });

      const url = editId ? ('/medidor/editar/' + editId) : '/medidor/cadastrar';

      try {
        const resp = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const json = await resp.json();
        if (json.success) {
          showAlert(editId ? 'Lançamento atualizado com sucesso!' : 'Lançamento salvo com sucesso!', 'success');
          if (json.csrfToken) {
            syncAllCsrfInputs(json.csrfToken);
          }
          resetFormToCreate();
          setTimeout(() => { modal.hide(); location.hash = 'tab-agua'; location.reload(); }, 1200);
        } else {
          showAlert(json.error || 'Erro ao salvar.', 'danger');
        }
      } catch {
        showAlert('Falha na comunicação com o servidor.', 'danger');
      } finally {
        setBusy(false);
      }
    });

    function setBusy(on) {
      document.getElementById('btnSalvarTxt').style.display  = on ? 'none'         : 'inline';
      document.getElementById('btnSalvarLoad').style.display = on ? 'inline-block'  : 'none';
      document.getElementById('btnSalvar').disabled = on;
    }

    function showAlert(msg, type) {
      const el = document.getElementById('formAlert');
      el.className = 'alert alert-' + type + ' mt-3';
      el.textContent = msg;
      el.style.display = 'block';
      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    document.getElementById('btnSalvarGas').addEventListener('click', async function () {
      const form = document.getElementById('formGas');
      const alertEl = document.getElementById('formAlertGas');
      if (!form.Tipo.value || !form.Fornecedor.value) {
        showAlertGas('Por favor, preencha Tipo e Fornecedor.', 'danger');
        return;
      }

      setBusyGas(true);
      alertEl.style.display = 'none';

      const editId = document.getElementById('gId').value;
      const body = {};
      new FormData(form).forEach((v, k) => { body[k] = v; });

      const url = editId ? ('/medidor/gas/editar/' + editId) : '/medidor/gas/cadastrar';

      try {
        const resp = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const json = await resp.json();
        if (json.success) {
          showAlertGas(editId ? 'Leitura atualizada com sucesso!' : 'Leitura salva com sucesso!', 'success');
          if (json.csrfToken) {
            syncAllCsrfInputs(json.csrfToken);
          }
          resetGasFormToCreate();
          setTimeout(() => { gasModal.hide(); location.hash = 'tab-gas'; location.reload(); }, 1200);
        } else {
          showAlertGas(json.error || 'Erro ao salvar.', 'danger');
        }
      } catch {
        showAlertGas('Falha na comunicação com o servidor.', 'danger');
      } finally {
        setBusyGas(false);
      }
    });

    function setBusyGas(on) {
      document.getElementById('btnSalvarGasTxt').style.display  = on ? 'none'         : 'inline';
      document.getElementById('btnSalvarGasLoad').style.display = on ? 'inline-block'  : 'none';
      document.getElementById('btnSalvarGas').disabled = on;
    }

    function showAlertGas(msg, type) {
      const el = document.getElementById('formAlertGas');
      el.className = 'alert alert-' + type + ' mt-3';
      el.textContent = msg;
      el.style.display = 'block';
      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    document.getElementById('btnSalvarFiltro').addEventListener('click', async function () {
      const form = document.getElementById('formFiltro');
      const alertEl = document.getElementById('formAlertFiltro');
      if (!form.Filtro.value) {
        showAlertFiltro('Por favor, selecione o Filtro.', 'danger');
        return;
      }

      setBusyFiltro(true);
      alertEl.style.display = 'none';

      const editId = document.getElementById('fltId').value;
      const body = {};
      new FormData(form).forEach((v, k) => { body[k] = v; });
      form.querySelectorAll('.input-decimal').forEach(el => {
        body[el.name] = decimalToFloatStr(body[el.name]);
      });

      const url = editId ? ('/medidor/filtro/editar/' + editId) : '/medidor/filtro/cadastrar';

      try {
        const resp = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const json = await resp.json();
        if (json.success) {
          showAlertFiltro(editId ? 'Leitura atualizada com sucesso!' : 'Leitura salva com sucesso!', 'success');
          if (json.csrfToken) {
            syncAllCsrfInputs(json.csrfToken);
          }
          resetFiltroFormToCreate();
          setTimeout(() => { filtroModal.hide(); location.hash = 'tab-filtro'; location.reload(); }, 1200);
        } else {
          showAlertFiltro(json.error || 'Erro ao salvar.', 'danger');
        }
      } catch {
        showAlertFiltro('Falha na comunicação com o servidor.', 'danger');
      } finally {
        setBusyFiltro(false);
      }
    });

    function setBusyFiltro(on) {
      document.getElementById('btnSalvarFiltroTxt').style.display  = on ? 'none'         : 'inline';
      document.getElementById('btnSalvarFiltroLoad').style.display = on ? 'inline-block'  : 'none';
      document.getElementById('btnSalvarFiltro').disabled = on;
    }

    function showAlertFiltro(msg, type) {
      const el = document.getElementById('formAlertFiltro');
      el.className = 'alert alert-' + type + ' mt-3';
      el.textContent = msg;
      el.style.display = 'block';
      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });
  </script>
</body>
</html>
