  <script>
  (function () {
    // Restaura a aba correta pelo hash da URL usando só JS puro, sem depender
    // de jQuery/Bootstrap/DataTables terem carregado — se algum desses scripts
    // externos falhar ou demorar, a aba ainda assim fica correta.
    var activeTab = { '#tab-gas': 'gas', '#tab-filtro': 'filtro', '#tab-consumo': 'consumo', '#tab-turno': 'turno' }[window.location.hash];
    if (!activeTab) return;

    var tabs = {
      agua:    { pane: 'tab-agua',    btn: 'tab-agua-btn',    fab: 'btnCadastrarMobile' },
      gas:     { pane: 'tab-gas',     btn: 'tab-gas-btn',     fab: 'btnCadastrarGasMobile' },
      filtro:  { pane: 'tab-filtro',  btn: 'tab-filtro-btn',  fab: 'btnCadastrarFiltroMobile' },
      consumo: { pane: 'tab-consumo', btn: 'tab-consumo-btn', fab: 'btnCadastrarConsumoMobile' },
      turno:   { pane: 'tab-turno',   btn: 'tab-turno-btn' },
    };

    Object.keys(tabs).forEach(function (key) {
      var isActive = key === activeTab;
      var pane = document.getElementById(tabs[key].pane);
      var btn  = document.getElementById(tabs[key].btn);
      var fab  = document.getElementById(tabs[key].fab);
      if (pane) {
        pane.classList.toggle('active', isActive);
        pane.classList.toggle('show', isActive);
      }
      if (btn) {
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      }
      if (fab) fab.classList.toggle('d-none', !isActive);
    });
  })();
  </script>

