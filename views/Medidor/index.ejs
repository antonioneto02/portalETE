<!DOCTYPE html>
<html>
<head>
  <title>Portal ETE — Medidor ETA</title>
  <%- include('../System/headIncludes.ejs') %>
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <style>
    /* ── Tabela ── */
    .badge-turno { font-size:.72rem; padding:3px 8px; border-radius:10px; }
    .dt-compact td, .dt-compact th { padding:6px 8px !important; font-size:.82rem; }
    .dt-compact th { white-space:nowrap; }
    .val-ok  { color:#16a34a; font-weight:600; }
    .val-warn{ color:#d97706; font-weight:600; }
    .val-bad { color:#b91c1c; font-weight:600; }
    .btn-excel { background:#16a34a !important; color:white !important; border:none !important; }
    .btn-excel:hover { background:#15803d !important; }
    @media (max-width:767px) { .dt-buttons { display:none !important; } }
    #tblMedidor_filter { display:flex !important; flex-wrap:wrap; align-items:center; gap:.4rem; }
    #tblMedidor_filter label { display:none !important; }
    @media (max-width:767px) {
      #tblMedidor_filter { display:grid !important; grid-template-columns:1fr 1fr; gap:.3rem; width:100%; }
      #tblMedidor_filter > div { width:100% !important; display:block !important; }
      #tblMedidor_filter > div input { width:100% !important; min-width:0 !important; box-sizing:border-box; }
    }

    /* ── Scroll da tabela ── */
    #tblMedidor_wrapper > div[style*="overflow-x"]::-webkit-scrollbar { height: 7px; }
    #tblMedidor_wrapper > div[style*="overflow-x"]::-webkit-scrollbar-track { background: #f3f4f6; border-radius: 4px; }
    #tblMedidor_wrapper > div[style*="overflow-x"]::-webkit-scrollbar-thumb { background: #9ca3af; border-radius: 4px; }
    #tblMedidor_wrapper > div[style*="overflow-x"]::-webkit-scrollbar-thumb:hover { background: #6b7280; }
    @media (max-width:767px) {
      #tblMedidor_filter { gap:.3rem; }
    }

    /* ── Modal ── */
    .modal-fullscreen-sm-down { max-height:100dvh; }
    #medidorModal .modal-body { overflow-y:auto; max-height:calc(100dvh - 140px); padding:16px; }

    /* ── Select2: mesmo visual do form-control ── */
    #medidorModal .select2-container { width:100% !important; }
    #medidorModal .select2-container--default .select2-selection--single {
      height:36px;
      border:1.5px solid #d1d5db;
      border-radius:6px;
      padding:.38rem .7rem;
      background:#fff;
      transition:border-color .15s, box-shadow .15s;
    }
    #medidorModal .select2-container--default.select2-container--focus .select2-selection--single,
    #medidorModal .select2-container--default.select2-container--open .select2-selection--single {
      border-color:#2B286F;
      box-shadow:0 0 0 .18rem rgba(43,40,111,.18);
      outline:none;
    }
    #medidorModal .select2-container--default .select2-selection--single .select2-selection__rendered {
      line-height:1.5; padding:0; color:#111827; font-size:.875rem;
    }
    #medidorModal .select2-container--default .select2-selection--single .select2-selection__placeholder {
      color:#9ca3af;
    }
    #medidorModal .select2-container--default .select2-selection--single .select2-selection__arrow {
      height:34px; right:6px;
    }
    #medidorModal .select2-container--default .select2-selection--single .select2-selection__clear {
      margin-right:14px; color:#9ca3af; font-size:1rem;
    }
    .select2-dropdown { z-index:9999; border:1.5px solid #d1d5db; border-radius:6px; font-size:.875rem; }
    .select2-container--default .select2-results__option--highlighted { background:#2B286F !important; }
    .select2-search--dropdown .select2-search__field {
      border:1px solid #d1d5db; border-radius:4px; padding:4px 8px; font-size:.85rem;
    }

    /* ── Seções do formulário ── */
    .form-section {
      background:#f8fafc;
      border:1px solid #e9edf2;
      border-radius:8px;
      padding:14px 14px 8px;
      margin-bottom:14px;
    }
    .form-section-title {
      display:flex; align-items:center; gap:7px;
      font-size:.7rem; font-weight:700; color:#2B286F;
      text-transform:uppercase; letter-spacing:.6px;
      border-left:3px solid #2B286F;
      padding:3px 8px; margin-bottom:12px;
      background:rgba(43,40,111,.06);
      border-radius:0 4px 4px 0;
    }
    .form-section-title i { font-size:.85rem; }

    /* ── Labels ── */
    .param-pair { display:flex; flex-direction:column; }
    .param-pair label {
      font-size:.7rem; font-weight:600;
      color:#6b7280; margin-bottom:3px;
      text-transform:uppercase; letter-spacing:.35px;
    }
    .param-pair .req { color:#D11F3F; }

    /* ── Inputs e Selects: mesma aparência ── */
    .param-pair .form-control,
    .param-pair .form-select {
      font-size:.875rem;
      color:#111827;
      border:1.5px solid #d1d5db;
      border-radius:6px;
      padding:.38rem .7rem;
      height:36px;
      background-color:#fff;
      box-shadow:none;
      transition:border-color .15s, box-shadow .15s;
    }
    .param-pair .form-select {
      padding-right:2rem;          /* espaço pro chevron */
      background-position:right .55rem center;
      background-size:14px 10px;
    }
    .param-pair textarea.form-control {
      height:auto; min-height:72px; resize:vertical;
    }
    .param-pair .form-control:focus,
    .param-pair .form-select:focus {
      border-color:#2B286F;
      box-shadow:0 0 0 .18rem rgba(43,40,111,.18);
      outline:none;
    }
    .param-pair .form-control::placeholder { color:#9ca3af; font-style:normal; }

    /* ── Par valor/aparelho lado a lado ── */
    .param-group {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:8px;
      align-items:end;
    }
    @media (max-width:480px) { .param-group { grid-template-columns:1fr; } }

    /* ── Alerta no form ── */
    #formAlert { font-size:.875rem; }
  </style>
</head>
<body>
  <div class="layout-container">
    <%- include('../partials/sidebar') %>
    <div class="main-content">
      <%- include('../partials/topbar', { pageTitle: 'Medidor ETA', pageIcon: 'speedometer2', username: username }) %>

      <div class="content">
        <% if (dbError) { %>
          <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i><%= dbError %></div>
        <% } %>

        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="bi bi-table me-2"></i>Lançamentos ETA</span>
            <button class="btn btn-sm" id="btnCadastrar"
              style="background:linear-gradient(135deg,#2B286F,#4a47a3);color:white;border:none;">
              <i class="bi bi-plus-lg me-1"></i>Cadastrar
            </button>
          </div>
          <div class="card-body p-0 p-md-3">
            <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;width:100%;">
              <table id="tblMedidor" class="table table-striped table-hover dt-compact w-100">
                <thead>
                  <tr>
                    <th>Data</th>
                    <th>Turno</th>
                    <th>Operador</th>
                    <th>Matrícula</th>
                    <th>Local</th>
                    <th>Aspecto</th>
                    <th>Ap. Visual</th>
                    <th>Cor</th>
                    <th>Ap. Cor</th>
                    <th>pH</th>
                    <th>Ap. pH</th>
                    <th>Cloro</th>
                    <th>Ap. Cloro</th>
                    <th>Turbidez</th>
                    <th>Ap. Turbidez</th>
                    <th>Alcalinidade</th>
                    <th>Ap. Alcalinidade</th>
                    <th>Ferro</th>
                    <th>Ap. Ferro</th>
                    <th>Dureza</th>
                    <th>Ap. Dureza</th>
                    <th>Início</th>
                    <th>Fim</th>
                    <th>Ligado</th>
                    <th>Desligado</th>
                    <th>OBS</th>
                  </tr>
                </thead>
                <tbody>
                <% lancamentos.forEach(function(l) {
                  // Divisor adaptativo: >=100 → ÷100, 10-99 → ÷10, <10 → ÷1
                  function adapt(v) {
                    if(v==null||v==='') return null;
                    const n = Number(v);
                    if(n>=100) return n/100;
                    if(n>=10)  return n/10;
                    return n;
                  }
                  function fmt(v) { const n=adapt(v); return n==null?'—':n.toFixed(2); }
                  function fmtDate(d) {
                    if(!d) return '—';
                    try { return new Date(d).toLocaleDateString('pt-BR'); } catch(e){ return String(d).substring(0,10); }
                  }
                  function turnoLabel(t) { return t===1?'Manhã':t===2?'Tarde':t===3?'Noite':t||'—'; }
                  function cls(raw, min, max) {
                    const v = adapt(raw);
                    if(v==null) return '';
                    if(min!=null&&max!=null){ if(v>=min&&v<=max)return 'val-ok'; if(v<min*0.8||v>max*1.2)return 'val-bad'; return 'val-warn'; }
                    return '';
                  }
                %>

                  <tr>
                    <td><%= fmtDate(l.Data) %></td>
                    <td>
                      <% if(l.turno) { %>
                        <span class="badge-turno" style="background:<%= l.turno===1?'#16a34a':l.turno===2?'#d97706':'#2B286F' %>;color:white;">
                          <%= turnoLabel(l.turno) %>
                        </span>
                      <% } else { %>—<% } %>
                    </td>
                    <td><%= l.Operador||'—' %></td>
                    <td><%= l.matricula||'—' %></td>
                    <td><%= l.LOCAL||'—' %></td>
                    <td><%= l.Aspecto_Visual||'—' %></td>
                    <td><%= l.Visual_Aparelho||'—' %></td>
                    <td class="<%= cls(l.Cor_Visual,0,15) %>"><%= fmt(l.Cor_Visual) %></td>
                    <td><%= fmt(l.Cor_Aparelho) %></td>
                    <td class="<%= cls(l.pH,6.5,9.5) %>"><%= fmt(l.pH) %></td>
                    <td><%= fmt(l.pH_Aparelho) %></td>
                    <td class="<%= cls(l.Cloro,0.2,5.0) %>"><%= fmt(l.Cloro) %></td>
                    <td><%= fmt(l.Cloro_Aparelho) %></td>
                    <td class="<%= cls(l.Turbidez,0,1.0) %>"><%= fmt(l.Turbidez) %></td>
                    <td><%= fmt(l.Turbidez_Aparelho) %></td>
                    <td><%= fmt(l.Alcalinidade) %></td>
                    <td><%= fmt(l.Alcalinidade_Aparelho) %></td>
                    <td class="<%= cls(l.Ferro,0,0.3) %>"><%= fmt(l.Ferro) %></td>
                    <td><%= fmt(l.Ferro_Aparelho) %></td>
                    <td><%= fmt(l.Dureza) %></td>
                    <td><%= fmt(l.Dureza_Aparelho) %></td>
                    <td><%= l.Inicial||'—' %></td>
                    <td><%= l.Final||'—' %></td>
                    <td><%= l.Ligado||'—' %></td>
                    <td><%= l.Deligado||'—' %></td>
                    <td style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= l.OBS||'—' %></td>
                  </tr>
                <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Cadastrar -->
  <div class="modal fade" id="medidorModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-fullscreen-sm-down">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Novo Lançamento ETA</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="formMedidor" novalidate>
            <input type="hidden" name="_csrf" id="csrfInput" value="<%= csrfToken %>">

            <!-- ① Identificação -->
            <div class="form-section">
              <div class="form-section-title"><i class="bi bi-person-badge"></i>Identificação</div>
              <div class="row g-2">
                <div class="col-6 col-md-3 param-pair">
                  <label for="fData">Data <span class="req">*</span></label>
                  <input type="date" class="form-control" id="fData" name="Data" required>
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="fTurno">Turno <span class="req">*</span></label>
                  <select class="form-control" id="fTurno" name="turno" required>
                    <option value="">— Selecione —</option>
                    <option>Manhã</option>
                    <option>Tarde</option>
                    <option>Noite</option>
                  </select>
                </div>
                <div class="col-12 col-md-4 param-pair">
                  <label for="fOperador">Operador <span class="req">*</span></label>
                  <select class="form-control" id="fOperador" name="Operador"></select>
                </div>
                <div class="col-6 col-md-2 param-pair">
                  <label for="fMatricula">Matrícula</label>
                  <input type="text" class="form-control" id="fMatricula" name="matricula"
                    placeholder="Auto" readonly
                    style="background:#f3f4f6;cursor:not-allowed;color:#6b7280;">
                </div>
                <div class="col-6 col-md-6 param-pair">
                  <label for="fLocal">Local</label>
                  <select class="form-control" id="fLocal" name="LOCAL">
                    <option value="">— Selecione —</option>
                    <option>ETA Compacta</option>
                    <option>Caixa Azul</option>
                    <option>Abrandador</option>
                    <option>Areia VEXER</option>
                    <option>Zeolita</option>
                    <option>Carvão VEXER</option>
                    <option>Abrandador VEXER</option>
                    <option>Reservatório</option>
                    <option>Areia</option>
                    <option>Carvão</option>
                    <option>Polidor</option>
                    <option>Inox</option>
                    <option>Poço 4</option>
                    <option>Poço 7</option>
                    <option>Acumulo</option>
                    <option>INOX</option>
                    <option>Sanepar Indu</option>
                    <option>Sanepar ADM</option>
                    <option>Efluente Industrial</option>
                  </select>
                </div>
                <div class="col-6 col-md-2 param-pair">
                  <label for="fInicial">Início</label>
                  <input type="time" class="form-control" id="fInicial" name="Inicial">
                </div>
                <div class="col-6 col-md-2 param-pair">
                  <label for="fFinal">Fim</label>
                  <input type="time" class="form-control" id="fFinal" name="Final">
                </div>
                <div class="col-6 col-md-2 param-pair">
                  <label for="fLigado">Ligado</label>
                  <input type="time" class="form-control" id="fLigado" name="Ligado">
                </div>
                <div class="col-6 col-md-1 param-pair">
                  <label for="fDeligado">Deslig.</label>
                  <input type="time" class="form-control" id="fDeligado" name="Deligado">
                </div>
              </div>
            </div>

            <!-- ② Aspectos Físicos -->
            <div class="form-section">
              <div class="form-section-title"><i class="bi bi-eye"></i>Aspectos Físicos</div>
              <div class="row g-2">
                <div class="col-12 col-md-5 param-pair">
                  <label for="fAspecto">Aspecto visual</label>
                  <select class="form-control" id="fAspecto" name="Aspecto_Visual">
                    <option value="">— Selecione —</option>
                    <option>Límpido</option>
                    <option>Turvo</option>
                    <option>Amarelado</option>
                    <option>Esverdeado</option>
                    <option>Sem Cor</option>
                  </select>
                </div>
                <div class="col-6 col-md-4 param-pair">
                  <label for="fCorVis">Cor visual <span style="color:#9ca3af;font-weight:400">(uH)</span></label>
                  <input type="number" step="0.01" min="0" class="form-control" id="fCorVis" name="Cor_Visual" placeholder="0.00">
                </div>
              </div>
            </div>

            <!-- ③ Parâmetros Químicos — valores medidos -->
            <div class="form-section">
              <div class="form-section-title"><i class="bi bi-droplet-half"></i>Parâmetros Químicos</div>
              <div class="row g-2">
                <div class="col-6 col-md-4 param-pair">
                  <label for="fpH">pH <span style="color:#9ca3af;font-weight:400">(6,5–9,5)</span></label>
                  <input type="number" step="0.01" min="0" max="14" class="form-control" id="fpH" name="pH" placeholder="7.00">
                </div>
                <div class="col-6 col-md-4 param-pair">
                  <label for="fCloro">Cloro <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                  <input type="number" step="0.01" min="0" class="form-control" id="fCloro" name="Cloro" placeholder="0.20">
                </div>
                <div class="col-6 col-md-4 param-pair">
                  <label for="fTurb">Turbidez <span style="color:#9ca3af;font-weight:400">(uT)</span></label>
                  <input type="number" step="0.01" min="0" class="form-control" id="fTurb" name="Turbidez" placeholder="0.00">
                </div>
                <div class="col-6 col-md-4 param-pair">
                  <label for="fAlc">Alcalinidade <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                  <input type="number" step="0.01" min="0" class="form-control" id="fAlc" name="Alcalinidade" placeholder="0.00">
                </div>
                <div class="col-6 col-md-4 param-pair">
                  <label for="fFerro">Ferro <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                  <input type="number" step="0.001" min="0" class="form-control" id="fFerro" name="Ferro" placeholder="0.000">
                </div>
                <div class="col-6 col-md-4 param-pair">
                  <label for="fDureza">Dureza <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                  <input type="number" step="0.01" min="0" class="form-control" id="fDureza" name="Dureza" placeholder="0.00">
                </div>
              </div>
            </div>

            <!-- ④ Leitura dos Aparelhos -->
            <div class="form-section">
              <div class="form-section-title"><i class="bi bi-rulers"></i>Leitura dos Aparelhos</div>
              <div class="row g-2">
                <div class="col-6 col-md-3 param-pair">
                  <label for="fVisualAp">Aparelho Aspecto</label>
                  <input type="text" class="form-control" id="fVisualAp" name="Visual_Aparelho" placeholder="Modelo/ID">
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="fCorAp">Aparelho Cor <span style="color:#9ca3af;font-weight:400">(uH)</span></label>
                  <input type="number" step="0.01" min="0" class="form-control" id="fCorAp" name="Cor_Aparelho" placeholder="0.00">
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="fpHAp">Aparelho pH</label>
                  <input type="number" step="0.01" min="0" max="14" class="form-control" id="fpHAp" name="pH_Aparelho" placeholder="7.00">
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="fCloroAp">Aparelho Cloro <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                  <input type="number" step="0.01" min="0" class="form-control" id="fCloroAp" name="Cloro_Aparelho" placeholder="0.20">
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="fTurbAp">Aparelho Turbidez <span style="color:#9ca3af;font-weight:400">(uT)</span></label>
                  <input type="number" step="0.01" min="0" class="form-control" id="fTurbAp" name="Turbidez_Aparelho" placeholder="0.00">
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="fAlcAp">Aparelho Alcalinidade</label>
                  <input type="number" step="0.01" min="0" class="form-control" id="fAlcAp" name="Alcalinidade_Aparelho" placeholder="0.00">
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="fFerroAp">Aparelho Ferro <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                  <input type="number" step="0.001" min="0" class="form-control" id="fFerroAp" name="Ferro_Aparelho" placeholder="0.000">
                </div>
                <div class="col-6 col-md-3 param-pair">
                  <label for="fDurezaAp">Aparelho Dureza <span style="color:#9ca3af;font-weight:400">(mg/L)</span></label>
                  <input type="number" step="0.01" min="0" class="form-control" id="fDurezaAp" name="Dureza_Aparelho" placeholder="0.00">
                </div>
              </div>
            </div>

            <!-- ⑤ Observações -->
            <div class="form-section">
              <div class="form-section-title"><i class="bi bi-chat-left-text"></i>Observações</div>
              <div class="param-pair">
                <label for="fObs">Ocorrências / Anotações do turno</label>
                <textarea class="form-control" id="fObs" name="OBS" rows="3"
                  placeholder="Descreva ocorrências, anomalias ou observações relevantes..."></textarea>
              </div>
            </div>

            <div id="formAlert" class="alert mt-2" style="display:none;"></div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" id="btnCancelar">Cancelar</button>
          <button type="button" class="btn" id="btnSalvar"
            style="background:linear-gradient(135deg,#2B286F,#4a47a3);color:white;border:none;min-width:110px;">
            <span id="btnSalvarTxt"><i class="bi bi-check-lg me-1"></i>Salvar</span>
            <span id="btnSalvarLoad" style="display:none;">
              <span class="spinner-border spinner-border-sm me-1"></span>Salvando...
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal confirmação cancelar -->
  <div class="modal fade" id="modalConfirmaCancelar" tabindex="-1" style="z-index:2060;">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content">
        <div class="modal-header py-2" style="background:linear-gradient(135deg,#2B286F,#1e1f5c);">
          <h6 class="modal-title text-white mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Descartar lançamento?</h6>
        </div>
        <div class="modal-body text-center py-3" style="font-size:.9rem;">
          Os dados preenchidos serão perdidos.<br>Deseja sair mesmo assim?
        </div>
        <div class="modal-footer py-2 justify-content-center gap-2">
          <button type="button" class="btn btn-sm btn-secondary" id="btnVoltarForm">
            <i class="bi bi-arrow-left me-1"></i>Voltar
          </button>
          <button type="button" class="btn btn-sm btn-danger" id="btnConfirmarSair">
            <i class="bi bi-x-lg me-1"></i>Sair sem salvar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS (modal) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
  $(document).ready(function () {

    // DataTable
    var isMobile = window.innerWidth <= 767;
    $('#tblMedidor').DataTable({
      language: {
        url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
      },
      order: [[0, 'desc']],
      pageLength: isMobile ? 10 : 25,
      scrollX: false,
      dom: '<"d-flex flex-wrap gap-2 align-items-center mb-2"Bf>rtip<"mt-1"l>',
      buttons: [
        {
          extend: 'excelHtml5',
          text: '<i class="bi bi-file-earmark-excel me-1"></i>Excel',
          className: 'btn btn-sm btn-excel',
          title: 'Lançamentos ETA',
        },
      ],
      initComplete: function () {
        dtBuildFilters(this.api(), 'tblMedidor_filter', [
          { idx: 1, label: 'Turno...',    w: '110px' },
          { idx: 2, label: 'Operador...', w: '140px' },
          { idx: 4, label: 'Local...',    w: '120px' },
          { idx: 0, label: 'Data...',     w: '120px' },
        ]);
      },
    });

    // Select2 — campos fixos
    const s2opts = { dropdownParent: $('#medidorModal'), allowClear: true, width: '100%' };
    $('#fTurno').select2({ ...s2opts, placeholder: '— Selecione —' });
    $('#fAspecto').select2({ ...s2opts, placeholder: '— Selecione —' });
    $('#fLocal').select2({ ...s2opts, placeholder: '— Selecione o local —' });

    // Select2 AJAX — Operador (busca em V_RECURSOS_HUMANOS)
    $('#fOperador').select2({
      dropdownParent: $('#medidorModal'),
      placeholder: 'Digite o nome do operador...',
      allowClear: true,
      width: '100%',
      minimumInputLength: 2,
      language: { inputTooShort: () => 'Digite ao menos 2 caracteres...' },
      ajax: {
        url: '/api/operadores',
        dataType: 'json',
        delay: 280,
        data: p => ({ q: p.term || '' }),
        processResults: d => ({ results: d }),
        cache: true,
      },
    });

    // Auto-preenche matrícula ao selecionar operador
    $('#fOperador').on('select2:select', function(e) {
      document.getElementById('fMatricula').value = e.params.data.matricula || '';
    });
    $('#fOperador').on('select2:clear', function() {
      document.getElementById('fMatricula').value = '';
    });

    // Pré-preenche data de hoje
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('fData').value = today;

    const modal = new bootstrap.Modal(document.getElementById('medidorModal'));
    const modalConfirma = new bootstrap.Modal(document.getElementById('modalConfirmaCancelar'));

    document.getElementById('btnCadastrar').addEventListener('click', () => modal.show());

    // Cancelar → pede confirmação
    document.getElementById('btnCancelar').addEventListener('click', function() {
      const form = document.getElementById('formMedidor');
      // Verifica se algum campo foi preenchido
      const preenchido = Array.from(form.elements).some(el =>
        el.type !== 'hidden' && el.name !== '_csrf' && el.readOnly !== true && el.value && el.value !== ''
      );
      if (preenchido) {
        modalConfirma.show();
      } else {
        modal.hide();
      }
    });

    document.getElementById('btnVoltarForm').addEventListener('click', () => modalConfirma.hide());
    document.getElementById('btnConfirmarSair').addEventListener('click', function() {
      modalConfirma.hide();
      modal.hide();
    });

    document.getElementById('btnSalvar').addEventListener('click', async function () {
      const form = document.getElementById('formMedidor');
      const alertEl = document.getElementById('formAlert');

      // Validação básica
      if (!form.Data.value || !form.turno.value) {
        showAlert('Por favor, preencha Data e Turno.', 'danger');
        return;
      }

      setBusy(true);
      alertEl.style.display = 'none';

      const body = {};
      new FormData(form).forEach((v, k) => { body[k] = v; });

      try {
        const resp = await fetch('/medidor/cadastrar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const json = await resp.json();
        if (json.success) {
          showAlert('Lançamento salvo com sucesso!', 'success');
          if (json.csrfToken) document.getElementById('csrfInput').value = json.csrfToken;
          form.reset();
          $('#fTurno').val('').trigger('change');
          $('#fAspecto').val('').trigger('change');
          $('#fLocal').val('').trigger('change');
          $('#fOperador').val(null).trigger('change');
          document.getElementById('fMatricula').value = '';
          document.getElementById('fData').value = today;
          setTimeout(() => { modal.hide(); location.reload(); }, 1200);
        } else {
          showAlert(json.error || 'Erro ao salvar.', 'danger');
        }
      } catch {
        showAlert('Falha na comunicação com o servidor.', 'danger');
      } finally {
        setBusy(false);
      }
    });

    function setBusy(on) {
      document.getElementById('btnSalvarTxt').style.display  = on ? 'none'         : 'inline';
      document.getElementById('btnSalvarLoad').style.display = on ? 'inline-block'  : 'none';
      document.getElementById('btnSalvar').disabled = on;
    }

    function showAlert(msg, type) {
      const el = document.getElementById('formAlert');
      el.className = 'alert alert-' + type + ' mt-3';
      el.textContent = msg;
      el.style.display = 'block';
      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });
  </script>
</body>
</html>
