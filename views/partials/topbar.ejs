<div class="topbar">
  <div class="topbar-left">
    <a href="/home" class="topbar-brand d-md-none text-decoration-none">
      <img src="/css/logo-cini.png" alt="ETE">
      <span>Portal ETE</span>
    </a>
    <h1 class="d-none d-md-flex align-items-center mb-0">
      <i class="bi bi-<%= pageIcon %> me-2"></i><%= pageTitle %>
    </h1>
  </div>
  <div class="topbar-right">
    <div class="topbar-user-avatar d-md-none" title="<%= username %>">
      <%= (username || 'U').charAt(0).toUpperCase() %>
    </div>
    <span class="d-none d-md-inline"><i class="bi bi-person-circle me-1"></i><%= username %></span>
    <a href="/logout" class="btn btn-sm d-none d-md-inline-flex"
       style="background:rgba(255,255,255,0.15);color:white;border:none;">
      <i class="bi bi-box-arrow-right me-1"></i>Sair
    </a>
  </div>
</div>
